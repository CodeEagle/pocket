.page { position: relative; width: 100%; height: 100%; overflow: hidden; }
.canvas { position: absolute; left: 0; top: 0; display: block; }
.ime { position: fixed; z-index: 20; box-sizing: border-box; margin: 0; padding: 0 6px; }
.error { position: absolute; z-index: 50; left: 8px; right: 8px; bottom: 8px; color: #ffb7b7; background: #411e25; padding: 8px; border-radius: 6px; font-size: 12px; }
