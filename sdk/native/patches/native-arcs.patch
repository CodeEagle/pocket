+#[test]
+fn native_arcs_preserve_signed_geometry_and_legacy_fallback() {
+    fn add_arc(ui: &mut Ui, sweep: f64, width: f64, rotate: f64) {
+        let node = ui.create_node(0);
+        for (prop, value) in [
+            (spec::prop::WIDTH, 190.0),
+            (spec::prop::HEIGHT, 190.0),
+            (spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64),
+            (spec::prop::INSET_L, 20.25),
+            (spec::prop::INSET_T, 10.5),
+            (spec::prop::ARC_START, 15.0),
+            (spec::prop::ARC_SWEEP, sweep),
+            (spec::prop::ARC_WIDTH, width),
+            (spec::prop::BG_COLOR, 0xff123456u32 as f64),
+            (spec::prop::ROTATE, rotate),
+        ] {
+            ui.set_prop(node, prop, value);
+        }
+        ui.insert_before(spec::ROOT_ID, node, 0);
+        ui.tick();
+    }
+
+    fn arcs(words: &[u32]) -> Vec<[u32; 7]> {
+        let mut result = Vec::new();
+        let mut i = 0;
+        while i < words.len() {
+            match words[i] {
+                spec::draw_op::ARC => {
+                    result.push(core::array::from_fn(|offset| words[i + 1 + offset]));
+                    i += 8;
+                }
+                spec::draw_op::RECT => i += 4,
+                spec::draw_op::GRAD_RECT => i += 6,
+                spec::draw_op::SCISSOR => i += 3,
+                spec::draw_op::SCISSOR_POP => i += 1,
+                other => panic!("unexpected DrawList op {other}"),
+            }
+        }
+        result
+    }
+
+    let cases = [
+        (90.0, 8.0, 8.0, 91.0),
+        (270.0, 8.0, 8.0, 91.0),
+        (-90.0, 8.0, 8.0, 91.0),
+        (360.0, 200.0, 95.0, 47.5),
+    ];
+    for (sweep, requested_width, expected_width, expected_radius) in cases {
+        let mut ui = Ui::new();
+        add_arc(&mut ui, sweep, requested_width, 0.0);
+        let legacy = ui.draw().words.clone();
+        assert_eq!(validate_drawlist(&legacy)[spec::draw_op::ARC as usize], 0);
+        assert!(validate_drawlist(&legacy).iter().sum::<u32>() > 100);
+
+        ui.set_native_rounded_rects(true);
+        let words = ui.draw().words.clone();
+        assert_eq!(validate_drawlist(&words)[spec::draw_op::ARC as usize], 1);
+        let record = arcs(&words).pop().unwrap();
+        assert_eq!(
+            (
+                f32::from_bits(record[0]),
+                f32::from_bits(record[1]),
+                f32::from_bits(record[2]),
+                f32::from_bits(record[3]),
+                f32::from_bits(record[4]),
+                f32::from_bits(record[5]),
+                record[6],
+            ),
+            (
+                115.0f32,
+                106.0f32,
+                expected_radius as f32,
+                expected_width as f32,
+                15.0f32,
+                sweep as f32,
+                0xff123456u32,
+            ),
+        );
+    }
+
+    let mut rotated = Ui::new();
+    add_arc(&mut rotated, 90.0, 8.0, 0.25);
+    rotated.set_native_rounded_rects(true);
+    let words = rotated.draw().words.clone();
+    assert_eq!(validate_drawlist(&words)[spec::draw_op::ARC as usize], 0);
+    assert!(arcs(&words).is_empty());
 }
 
