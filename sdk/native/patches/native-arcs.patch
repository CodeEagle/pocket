+fn arc_bounds(words: &[u32], clip: DamageRect) -> DamageRect {
+    let values = [1usize, 2, 3, 4].map(|index| f32::from_bits(words[index]));
+    let [cx, cy, radius, stroke_width] = values;
+    if !values.iter().all(|value| value.is_finite()) || radius < 0.0 || stroke_width <= 0.0 {
+        return clip;
+    }
+    let outer = radius + stroke_width * 0.5;
+    let bounds = [cx - outer - 1.0, cy - outer - 1.0, cx + outer + 1.0, cy + outer + 1.0];
+    if !bounds.iter().all(|value| value.is_finite()) {
+        return clip;
+    }
+    DamageRect::new(
+        floor_i32(bounds[0]),
+        floor_i32(bounds[1]),
+        ceil_i32(bounds[2]),
+        ceil_i32(bounds[3]),
+    )
+    .intersect(clip)
+}
