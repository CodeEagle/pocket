+#[test]
+fn static_img_entries_use_the_larger_limit_without_widening_general_textures() {
+    let mut ui = Ui::new();
+    let dimension = spec::IMG_MAX_DIM;
+    let initial_slots = ui.texture_slot_count();
+
+    // Both the IMG dimension check and payload check happen before tex_alloc.
+    // Failed blobs must leave no live handle or allocated slot behind.
+    let mut too_large = Vec::from([0u8; 8]);
+    too_large[..2].copy_from_slice(&((spec::IMG_MAX_DIM * 2) as u16).to_le_bytes());
+    too_large[2..4].copy_from_slice(&1u16.to_le_bytes());
+    too_large[4] = spec::psm::PSM_8888 as u8;
+    assert_eq!(ui.upload_img_entry(&too_large), -1);
+    assert_eq!(ui.texture_slot_count(), initial_slots);
+    assert!(ui.texture_at(0).is_none());
+
+    let mut too_tall = Vec::from([0u8; 8]);
+    too_tall[..2].copy_from_slice(&1u16.to_le_bytes());
+    too_tall[2..4].copy_from_slice(&((spec::IMG_MAX_DIM * 2) as u16).to_le_bytes());
+    too_tall[4] = spec::psm::PSM_8888 as u8;
+    assert_eq!(ui.upload_img_entry(&too_tall), -1);
+    assert_eq!(ui.texture_slot_count(), initial_slots);
+
+    let mut truncated = Vec::from([0u8; 8]);
+    truncated[..2].copy_from_slice(&(dimension as u16).to_le_bytes());
+    truncated[2..4].copy_from_slice(&(dimension as u16).to_le_bytes());
+    truncated[4] = spec::psm::PSM_8888 as u8;
+    assert_eq!(ui.upload_img_entry(&truncated), -1);
+    assert_eq!(ui.texture_slot_count(), initial_slots);
+    assert!(ui.texture_at(0).is_none());
+    truncated[5] = spec::img::FLAG_RLE;
+    assert_eq!(ui.upload_img_entry(&truncated), -1, "malformed RLE drops its temporary decode buffer");
+    assert_eq!(ui.texture_slot_count(), initial_slots);
+
+    let payload_len = dimension as usize * dimension as usize * 4;
+    let mut image = Vec::with_capacity(8 + payload_len);
+    image.extend_from_slice(&(dimension as u16).to_le_bytes());
+    image.extend_from_slice(&(dimension as u16).to_le_bytes());
+    image.push(spec::psm::PSM_8888 as u8);
+    image.push(0);
+    image.extend_from_slice(&[0, 0]);
+    image.resize(8 + payload_len, 0x5a);
+
+    let handle = ui.upload_img_entry(&image);
+    assert_eq!(handle, 0, "rejected uploads must not consume a texture slot");
+    let texture = ui.texture(handle).unwrap();
+    assert_eq!((texture.w, texture.h), (dimension, dimension));
+    assert_eq!(texture.pixels.len(), payload_len);
+    assert_eq!(texture.pixels[0], 0x5a);
+    assert_eq!(ui.texture_at(0).unwrap().0, handle);
+
+    // Static IMG dimensions flow through the same texture handle used by PMS1
+    // meshes; UVs remain normalized and vertex color modulation is unchanged.
+    let image_node = ui.create_node(spec::NodeType::Image as u8);
+    ui.set_prop(image_node, spec::prop::WIDTH, 100.0);
+    ui.set_prop(image_node, spec::prop::HEIGHT, 100.0);
+    ui.set_prop(image_node, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(image_node, spec::prop::INSET_T, 0.0);
+    ui.set_prop(image_node, spec::prop::INSET_L, 0.0);
+    ui.insert_before(spec::ROOT_ID, image_node, 0);
+    let mut mesh = Vec::new();
+    mesh.extend_from_slice(&0x31534d50u32.to_le_bytes()); // PMS1
+    mesh.extend_from_slice(&3u32.to_le_bytes()); // vertices
+    mesh.extend_from_slice(&3u32.to_le_bytes()); // indices
+    mesh.extend_from_slice(&0x80402010u32.to_le_bytes()); // ABGR modulate
+    for vertex in [
+        [0.0f32, 0.0, 0.0, 0.0],
+        [100.0, 0.0, 1.0, 0.0],
+        [0.0, 100.0, 0.0, 1.0],
+    ] {
+        for value in vertex {
+            mesh.extend_from_slice(&value.to_le_bytes());
+        }
+    }
+    for index in [0u32, 1, 2] {
+        mesh.extend_from_slice(&index.to_le_bytes());
+    }
+    assert!(ui.set_mesh(image_node, handle, &mesh));
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    let triangle = words.iter().position(|&word| word == spec::draw_op::TEX_TRI).unwrap();
+    assert_eq!(words[triangle + 1], handle as u32);
+    assert_eq!(words[triangle + 11], 0x80402010, "mesh color modulation is preserved");
+    assert_eq!(f32::from_bits(words[triangle + 6]), 1.0, "normalized UV reaches texture edge");
+
+    assert_eq!(
+        ui.upload_texture(&[], spec::TEX_MAX_DIM * 2, 1, spec::psm::PSM_8888),
+        -1,
+        "general texture upload must retain the 512px limit",
+    );
+
+    assert_eq!(ui.texture_slot_count(), 1);
+}
+
 /// Build a tiny 2x2-tile TILESET blob (4x4 CLUT8 tiles, RLE + linear):
 /// tile 0 = stream of index 5, tile 1 = ABSENT, tile 2 = SOLID(index 9),
 /// tile 3 = stream of index 6.
diff --git a/tests/image-pak.test.ts b/tests/image-pak.test.ts
--- /dev/null
+++ b/tests/image-pak.test.ts
@@ -0,0 +1,34 @@
+import { expect, test } from "bun:test";
+import { IMG_MAX_DIM, PSM, TEX_MAX_DIM } from "../contracts/spec/spec.ts";
+import { encodeImageEntry } from "../framework/compiler/pak.ts";
+
+function image(width: number, height: number) {
+  return {
+    width,
+    height,
+    rgba: new Uint8Array(width * height * 4),
+  };
+}
+
+test("static PAK IMG entries admit the explicit 2048px bound", () => {
+  expect(TEX_MAX_DIM).toBe(512);
+  expect(IMG_MAX_DIM).toBe(2048);
+
+  for (const [width, height] of [[512, 512], [1024, 1], [1, 1024]]) {
+    const entry = encodeImageEntry(image(width, height), PSM.PSM_8888);
+    const view = new DataView(entry.buffer, entry.byteOffset, entry.byteLength);
+    expect([view.getUint16(0, true), view.getUint16(2, true)]).toEqual([width, height]);
+  }
+
+  const largest = encodeImageEntry(image(2048, 2048), PSM.PSM_8888);
+  const largestView = new DataView(largest.buffer, largest.byteOffset, largest.byteLength);
+  expect([largestView.getUint16(0, true), largestView.getUint16(2, true)]).toEqual([2048, 2048]);
+  expect(largest.byteLength).toBe(8 + 2048 * 2048 * 4);
+
+  expect(() => encodeImageEntry({ width: 4096, height: 1, rgba: new Uint8Array() }, PSM.PSM_8888))
+    .toThrow("dims must be pow2 <= 2048");
+  expect(() => encodeImageEntry({ width: 1, height: 4096, rgba: new Uint8Array() }, PSM.PSM_8888))
+    .toThrow("dims must be pow2 <= 2048");
+  expect(() => encodeImageEntry({ width: 1536, height: 512, rgba: new Uint8Array() }, PSM.PSM_8888))
+    .toThrow("dims must be pow2 <= 2048");
+});
