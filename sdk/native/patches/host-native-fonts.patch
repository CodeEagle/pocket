+#[test]
+fn native_transformed_text_routes_tracking_and_transforms_to_text_run() {
+    let mut ui = Ui::new();
+    ui.set_viewport(320.0, 240.0);
+    ui.set_text_measure(Some(alloc::boxed::Box::new(|text: &str, _slot, tracking, line_h| {
+        let lines = text.split('\n').count() as f32;
+        let w = text
+            .split('\n')
+            .map(|line| line.chars().count() as f32 * (8.0 + tracking))
+            .fold(0.0f32, f32::max);
+        let lh = if line_h.is_nan() { 16.0 } else { line_h };
+        (w, lines * lh)
+    })));
+
+    let box_id = ui.create_node(spec::NodeType::View as u8);
+    ui.set_prop(box_id, spec::prop::WIDTH, 160.0);
+    ui.set_prop(box_id, spec::prop::HEIGHT, 60.0);
+    ui.set_prop(box_id, spec::prop::TRANSLATE_X, 40.0);
+    ui.set_prop(box_id, spec::prop::TRANSLATE_Y, 60.0);
+    ui.set_prop(box_id, spec::prop::ROTATE, 30.0);
+    ui.set_prop(box_id, spec::prop::SCALE, 1.25);
+    ui.insert_before(spec::ROOT_ID, box_id, 0);
+
+    let color = abgr(10, 20, 30, 255);
+    let label = ui.create_node(spec::NodeType::Text as u8);
+    ui.set_text(label, "HOST");
+    ui.set_prop(label, spec::prop::TEXT_COLOR, color as f64);
+    ui.set_prop(label, spec::prop::TRACKING, 2.0);
+    ui.insert_before(box_id, label, 0);
+
+    // Default off: without a baked font atlas, tracked/transformed text emits nothing.
+    let legacy = ui.draw().words.clone();
+    let legacy_counts = validate_drawlist(&legacy);
+    assert_eq!(legacy_counts[spec::draw_op::TEXT_RUN as usize], 0);
+    assert_eq!(legacy_counts[spec::draw_op::GLYPH_RUN as usize], 0);
+
+    // Opt-in enabled: tracked + rotated/scaled text emits a single vector TEXT_RUN
+    // with zero baked font atlases installed.
+    ui.set_native_transformed_text(true);
+    let words = ui.draw().words.clone();
+    let counts = validate_drawlist(&words);
+    assert_eq!(counts[spec::draw_op::TEXT_RUN as usize], 1);
+    assert_eq!(counts[spec::draw_op::GLYPH_RUN as usize], 0);
+    let at = words.iter().position(|&w| w == spec::draw_op::TEXT_RUN).unwrap();
+    let header = words[at + 1];
+    assert_ne!(header & spec::draw_op::TEXT_RUN_FLAG_TRACKING, 0);
+    assert_ne!(header & spec::draw_op::TEXT_RUN_FLAG_AFFINE, 0);
+    assert_eq!(words[at + 6], color);
+    assert_eq!(f32::from_bits(words[at + 8]), 2.0);
+    let a = f32::from_bits(words[at + 9]);
+    let b = f32::from_bits(words[at + 10]);
+    assert!((a - 1.25 * (30.0f32.to_radians().cos())).abs() < 1e-3);
+    assert!((b - 1.25 * (30.0f32.to_radians().sin())).abs() < 1e-3);
+    assert_eq!(decode_text_run_text(&words, at).0, "HOST");
+
+    // wrapText works via greedy native measurement even with zero baked atlases.
+    let breaks = ui.wrap_text("HOST NATIVE VECTOR FONT", 2, 60.0);
+    assert!(!breaks.is_empty());
+}
