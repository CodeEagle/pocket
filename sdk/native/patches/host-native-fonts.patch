+    let stage = ui.create_node(spec::NodeType::View as u8);
+    ui.set_prop(stage, spec::prop::WIDTH, 200.0);
+    ui.set_prop(stage, spec::prop::HEIGHT, 120.0);
+    ui.set_prop(stage, spec::prop::PERSPECTIVE, 400.0);
+    ui.insert_before(spec::ROOT_ID, stage, 0);
+
+    let card = ui.create_node(spec::NodeType::View as u8);
+    ui.set_prop(card, spec::prop::WIDTH, 160.0);
+    ui.set_prop(card, spec::prop::HEIGHT, 60.0);
+    ui.set_prop(card, spec::prop::ROTATE_Y, 35.0);
+    ui.set_prop(card, spec::prop::TRANSLATE_Z, -80.0);
+    ui.insert_before(stage, card, 0);
+
+    let label = ui.create_node(spec::NodeType::Text as u8);
+    ui.set_text(label, "AB");
+    ui.set_prop(label, spec::prop::FONT_SLOT, 0.0);
+    ui.set_prop(label, spec::prop::TEXT_COLOR, abgr(240, 240, 255, 255) as f64);
+    ui.insert_before(card, label, 0);
+
+    // Font-less package in 3D: falls back to projected native TEXT_RUN with affine foreshortening.
+    let fontless_words = ui.draw().words.clone();
+    let fontless_counts = validate_drawlist(&fontless_words);
+    assert_eq!(fontless_counts[spec::draw_op::TEXT_RUN as usize], 1);
+    assert_eq!(fontless_counts[spec::draw_op::GLYPH_RUN as usize], 0);
