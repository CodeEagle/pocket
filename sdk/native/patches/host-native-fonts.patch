+
+#[test]
+fn text_run_decodes_tracking_and_affine_extensions_and_rejects_invalid_headers() {
+    let tracked_affine = [
+        TEXT_RUN,
+        2 | (1 << 8) | TEXT_RUN_FLAG_TRACKING | TEXT_RUN_FLAG_AFFINE,
+        12.0f32.to_bits(),
+        24.0f32.to_bits(),
+        80.0f32.to_bits(),
+        20.0f32.to_bits(),
+        0xffff_ffff,
+        4,
+        1.5f32.to_bits(),
+        0.866f32.to_bits(),
+        0.5f32.to_bits(),
+        (-0.5f32).to_bits(),
+        0.866f32.to_bits(),
+        u32::from_le_bytes(*b"ABCD"),
+    ];
+    assert_eq!(word_len(&tracked_affine, 0), Ok(14));
+    validate(&tracked_affine, SCREEN).unwrap();
+
+    let mut unknown_flag = tracked_affine;
+    unknown_flag[1] |= 1 << 18;
+    assert_eq!(word_len(&unknown_flag, 0), Err(DecodeError::InvalidTextRun));
+
+    let mut nan_affine = tracked_affine;
+    nan_affine[10] = f32::NAN.to_bits();
+    assert_eq!(validate(&nan_affine, SCREEN), Err(DecodeError::InvalidTextRun));
 }
