+
+struct MeshLayerTarget<'a> {
+    pixels: &'a mut [u8],
+    stride: i32,
+    height: i32,
+    bounds: Clip,
+}
+
+impl MeshLayerTarget<'_> {
+    fn local_pixel(&self, full_offset: usize) -> Option<usize> {
+        let stride = self.stride as usize;
+        if stride == 0 { return None; }
+        let x = (full_offset % stride) as i32;
+        let y = (full_offset / stride) as i32;
+        if y >= self.height || x < self.bounds.x0 || x >= self.bounds.x1 || y < self.bounds.y0 || y >= self.bounds.y1 { return None; }
+        Some(((y - self.bounds.y0) as usize * (self.bounds.x1 - self.bounds.x0) as usize + (x - self.bounds.x0) as usize) * 4)
+    }
+}
+
+impl RenderTarget for MeshLayerTarget<'_> {
+    fn pixel_len(&self) -> usize { self.stride as usize * self.height as usize }
+
+    fn blend(&mut self, offset: usize, r: u32, g: u32, b: u32, a: u32) {
+        if a == 0 { return; }
+        let Some(local) = self.local_pixel(offset) else { return; };
+        let inverse = 255 - a;
+        for (index, source) in [r, g, b].into_iter().enumerate() {
+            self.pixels[local + index] = ((source * a + self.pixels[local + index] as u32 * inverse + 127) / 255) as u8;
+        }
+        self.pixels[local + 3] = ((a * 255 + self.pixels[local + 3] as u32 * inverse + 127) / 255) as u8;
+    }
+
+    fn fill_opaque(&mut self, start: usize, len: usize, r: u32, g: u32, b: u32) {
+        for offset in start..start.saturating_add(len) { self.blend(offset, r, g, b, 255); }
+    }
+}
+
+struct MeshMaskTarget<'a> {
+    alpha: &'a mut [u8],
+    stride: i32,
+    height: i32,
+    bounds: Clip,
+}
+
+impl MeshMaskTarget<'_> {
+    fn local_pixel(&self, full_offset: usize) -> Option<usize> {
+        let stride = self.stride as usize;
+        if stride == 0 { return None; }
+        let x = (full_offset % stride) as i32;
+        let y = (full_offset / stride) as i32;
+        if y >= self.height || x < self.bounds.x0 || x >= self.bounds.x1 || y < self.bounds.y0 || y >= self.bounds.y1 { return None; }
+        Some((y - self.bounds.y0) as usize * (self.bounds.x1 - self.bounds.x0) as usize + (x - self.bounds.x0) as usize)
+    }
+}
+
+impl RenderTarget for MeshMaskTarget<'_> {
+    fn pixel_len(&self) -> usize { self.stride as usize * self.height as usize }
+
+    fn blend(&mut self, offset: usize, _r: u32, _g: u32, _b: u32, a: u32) {
+        if a == 0 { return; }
+        let Some(local) = self.local_pixel(offset) else { return; };
+        let dest = self.alpha[local] as u32;
+        self.alpha[local] = (a + (dest * (255 - a) + 127) / 255).min(255) as u8;
+    }
+
+    fn fill_opaque(&mut self, start: usize, len: usize, _r: u32, _g: u32, _b: u32) {
+        for offset in start..start.saturating_add(len) {
+            if let Some(local) = self.local_pixel(offset) { self.alpha[local] = 255; }
+        }
+    }
+}
+
+#[inline]
+fn rect_pixels(rect: Clip) -> usize {
+    if rect.x0 >= rect.x1 || rect.y0 >= rect.y1 { return 0; }
+    (rect.x1 - rect.x0) as usize * (rect.y1 - rect.y0) as usize
+}
