+#[allow(clippy::too_many_arguments)]
+pub(crate) fn render_mesh_operation<T: RenderTarget>(
+    resources: &(impl RenderResources + ?Sized),
+    operation: &Operation<'_>,
+    target: &mut T,
+    stride: i32,
+    height: i32,
+    scale: i32,
+    clip: Clip,
+    layer: &mut Option<MeshLayer>,
+    scratch: &mut MeshScratch,
+) -> Result<bool, RenderError> {
+    match operation.opcode {
+        draw_op::MESH_LAYER_BEGIN => {
+            let bounds = packed_bounds(operation.words[1], operation.words[2], scale).intersect(clip);
+            scratch.layer[..rect_pixels(bounds) * 4].fill(0);
+            let tint = core::array::from_fn(|index| f32::from_bits(operation.words[4 + index]));
+            *layer = Some(MeshLayer { bounds, blend: operation.words[3], tint, mask: None });
+            return Ok(true);
+        }
+        draw_op::MESH_MASK_BEGIN => {
+            let state = layer.as_mut().ok_or(RenderError::InvalidFrame)?;
+            let bounds = packed_bounds(operation.words[2], operation.words[3], scale).intersect(state.bounds).intersect(clip);
+            scratch.mask[..rect_pixels(bounds)].fill(0);
+            state.mask = Some(MeshMask { bounds, inverted: operation.words[1] != 0 });
+            return Ok(true);
+        }
+        draw_op::MESH_LAYER_RESTORE => {
+            let state = layer.take().ok_or(RenderError::InvalidFrame)?;
+            composite_mesh_layer(target, stride, state, scratch);
+            return Ok(true);
+        }
+        _ => {}
+    }
+    let Some(state) = *layer else { return Ok(false); };
+    if matches!(operation.opcode, draw_op::SCISSOR | draw_op::SCISSOR_POP) { return Ok(true); }
+    if !matches!(operation.opcode, draw_op::TEX_TRI | draw_op::TEX_TRI_REPEAT | draw_op::TEX_TRI_FLOAT | draw_op::TEX_TRI_REPEAT_FLOAT) {
+        return Ok(true);
+    }
+    let Some(mask) = state.mask else {
+        let triangle_clip = clip.intersect(state.bounds);
+        if triangle_clip.x0 >= triangle_clip.x1 || triangle_clip.y0 >= triangle_clip.y1 { return Ok(true); }
+        let operation_resources = OperationResources::new(resources, operation, scale as u32)?;
+        let bytes = rect_pixels(state.bounds) * 4;
+        let mut isolated = MeshLayerTarget { pixels: &mut scratch.layer[..bytes], stride, height, bounds: state.bounds };
+        render_mesh_triangle(&operation_resources, &mut isolated, stride, scale, triangle_clip, operation, Some(state.tint));
+        return Ok(true);
+    };
+    let triangle_clip = clip.intersect(mask.bounds);
+    if triangle_clip.x0 >= triangle_clip.x1 || triangle_clip.y0 >= triangle_clip.y1 { return Ok(true); }
+    let operation_resources = OperationResources::new(resources, operation, scale as u32)?;
+    let bytes = rect_pixels(mask.bounds);
+    let mut isolated = MeshMaskTarget { alpha: &mut scratch.mask[..bytes], stride, height, bounds: mask.bounds };
+    render_mesh_triangle(&operation_resources, &mut isolated, stride, scale, triangle_clip, operation, None);
+    Ok(true)
+}
+
+fn packed_bounds(xy_word: u32, wh_word: u32, scale: i32) -> Clip {
+    let (x, y) = xy(xy_word, scale);
+    let (width, height) = wh(wh_word, scale);
+    Clip { x0: x, y0: y, x1: x.saturating_add(width), y1: y.saturating_add(height) }
+}
+
+fn composite_mesh_layer<T: RenderTarget>(target: &mut T, stride: i32, layer: MeshLayer, scratch: &MeshScratch) {
+    let width = (layer.bounds.x1 - layer.bounds.x0).max(0) as usize;
+    for y in layer.bounds.y0..layer.bounds.y1 {
+        for x in layer.bounds.x0..layer.bounds.x1 {
+            let local = ((y - layer.bounds.y0) as usize * width + (x - layer.bounds.x0) as usize) * 4;
+            let mut source = [
+                scratch.layer[local] as u32,
+                scratch.layer[local + 1] as u32,
+                scratch.layer[local + 2] as u32,
+                scratch.layer[local + 3] as u32,
+            ];
+            if source[3] == 0 { continue; }
+            if let Some(mask) = layer.mask {
+                let factor = if x >= mask.bounds.x0 && x < mask.bounds.x1 && y >= mask.bounds.y0 && y < mask.bounds.y1 {
+                    let mask_width = (mask.bounds.x1 - mask.bounds.x0) as usize;
+                    let index = (y - mask.bounds.y0) as usize * mask_width + (x - mask.bounds.x0) as usize;
+                    let coverage = scratch.mask[index] as u32;
+                    if mask.inverted { 255 - coverage } else { coverage }
+                } else if mask.inverted {
+                    255
+                } else {
+                    0
+                };
+                for channel in &mut source { *channel = (*channel * factor + 127) / 255; }
+                if source[3] == 0 { continue; }
+            }
+            target.composite_mesh((y * stride + x) as usize, source, layer.blend);
+        }
     }
 }
 
