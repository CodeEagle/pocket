+#[inline]
+fn composite_mesh_opaque(destination: [u32; 3], source: [u32; 4], blend: u32) -> [u32; 3] {
+    let alpha = source[3];
+    if alpha == 0 { return destination; }
+    let straight = |channel: u32| ((channel * 255 + alpha / 2) / alpha).min(255);
+    let source_rgb = [straight(source[0]), straight(source[1]), straight(source[2])];
+    core::array::from_fn(|index| {
+        let dest = destination[index];
+        match blend {
+            // BlendMode.plus adds premultiplied source directly to the
+            // destination; interpolating a saturated straight result would
+            // incorrectly reduce partially opaque highlights.
+            1 => (dest + source[index]).min(255),
+            2 | 3 => {
+                let blended = if blend == 2 {
+                    (dest * source_rgb[index] + 127) / 255
+                } else {
+                    255 - (((255 - dest) * (255 - source_rgb[index]) + 127) / 255)
+                };
+                (blended * alpha + dest * (255 - alpha) + 127) / 255
+            }
+            _ => (source[index] + (dest * (255 - alpha) + 127) / 255).min(255),
+        }
+    })
+}
+
+#[inline]
+fn composite_mesh_premultiplied(destination: [u32; 4], source: [u32; 4], blend: u32) -> [u32; 4] {
+    let (sa, da) = (source[3], destination[3]);
+    if sa == 0 { return destination; }
+    if blend == 1 {
+        return [
+            (source[0] + destination[0]).min(255),
+            (source[1] + destination[1]).min(255),
+            (source[2] + destination[2]).min(255),
+            (sa + da).min(255),
+        ];
+    }
+    let alpha = sa + (da * (255 - sa) + 127) / 255;
+    if blend == 0 {
+        return [
+            (source[0] + (destination[0] * (255 - sa) + 127) / 255).min(255),
+            (source[1] + (destination[1] * (255 - sa) + 127) / 255).min(255),
+            (source[2] + (destination[2] * (255 - sa) + 127) / 255).min(255),
+            alpha.min(255),
+        ];
+    }
+    let unpremultiply = |color: u32, coverage: u32| {
+        if coverage == 0 { 0 } else { ((color * 255 + coverage / 2) / coverage).min(255) }
+    };
+    let overlap_alpha = sa * da;
+    let color = |index: usize| {
+        let source_straight = unpremultiply(source[index], sa);
+        let destination_straight = unpremultiply(destination[index], da);
+        let blended = if blend == 2 {
+            (source_straight * destination_straight + 127) / 255
+        } else {
+            255 - (((255 - source_straight) * (255 - destination_straight) + 127) / 255)
+        };
+        let source_only = (source[index] * (255 - da) + 127) / 255;
+        let destination_only = (destination[index] * (255 - sa) + 127) / 255;
+        let overlap = (blended * overlap_alpha + 32_512) / 65_025;
+        (source_only + destination_only + overlap).min(255)
+    };
+    [color(0), color(1), color(2), alpha.min(255)]
+}
