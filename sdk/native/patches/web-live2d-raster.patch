+pub(crate) fn has_mesh_layer(words: &[u32], viewport: DamageRect) -> Result<bool, RenderError> {
+    for operation in pocket_draw_ops::DrawOps::new(words, viewport) {
+        if operation.map_err(|_| RenderError::InvalidFrame)?.opcode == draw_op::MESH_LAYER_BEGIN {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+pub(crate) fn ensure_mesh_scratch(scratch: &mut MeshScratch, has_mesh: bool, region: Clip) -> Result<(), RenderError> {
+    if !has_mesh { return Ok(()); }
+    let width = usize::try_from(region.x1 - region.x0).map_err(|_| RenderError::InvalidFrame)?;
+    let height = usize::try_from(region.y1 - region.y0).map_err(|_| RenderError::InvalidFrame)?;
+    let pixels = width.checked_mul(height).ok_or(RenderError::InvalidFrame)?;
+    reserve_scratch(&mut scratch.layer, pixels.checked_mul(4).ok_or(RenderError::InvalidFrame)?)?;
+    reserve_scratch(&mut scratch.mask, pixels)?;
+    Ok(())
+}
+
+fn reserve_scratch(buffer: &mut Vec<u8>, required: usize) -> Result<(), RenderError> {
+    if required > buffer.capacity() {
+        buffer.try_reserve_exact(required.saturating_sub(buffer.len())).map_err(|_| RenderError::Unsupported)?;
+    }
+    if buffer.len() < required { buffer.resize(required, 0); }
+    Ok(())
+}
