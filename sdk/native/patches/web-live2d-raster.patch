+/// Render one validated mesh triangle into an opaque or isolated target. The
+/// surface renderer uses this entry point to reuse the ordinary barycentric
+/// coverage, modulation and texture samplers for layer and mask triangles.
+pub(crate) fn render_mesh_triangle<T: RenderTarget>(
+    resources: &(impl RenderResources + ?Sized),
+    target: &mut T,
+    stride: i32,
+    scale: i32,
+    clip: Clip,
+    operation: &Operation<'_>,
+    tint: Option<[f32; 6]>,
+) {
+    let repeat = matches!(
+        operation.opcode,
+        draw_op::TEX_TRI_REPEAT | draw_op::TEX_TRI_REPEAT_FLOAT
+    );
+    match operation.opcode {
+        draw_op::TEX_TRI | draw_op::TEX_TRI_REPEAT => tex_tri(
+            resources,
+            target,
+            stride,
+            scale,
+            clip,
+            &operation.words[1..],
+            repeat,
+            tint,
+        ),
+        draw_op::TEX_TRI_FLOAT | draw_op::TEX_TRI_REPEAT_FLOAT => tex_tri_float(
+            resources,
+            target,
+            stride,
+            scale,
+            clip,
+            &operation.words[1..],
+            repeat,
+            tint,
+        ),
+        _ => {}
     }
 }
 
