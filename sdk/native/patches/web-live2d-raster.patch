+        lerp8(
+            lerp8(c0, c1, fx),
+            lerp8(c2, c3, fx),
+            fy,
+        )
+    };
+    Some((
+        mix(c00.0, c01.0, c10.0, c11.0),
+        mix(c00.1, c01.1, c10.1, c11.1),
+        mix(c00.2, c01.2, c10.2, c11.2),
+        mix(c00.3, c01.3, c10.3, c11.3),
