+/// Deterministic bilinear sample with repeat addressing. Coordinates are
+/// reduced before fixed-point conversion, so the documented +/-1,000,000 UV
+/// range cannot overflow the sampler's signed 24.8 intermediate.
+#[inline]
+fn sample_linear_repeat(view: &TexView, u: f32, v: f32) -> Option<(u32, u32, u32, u32)> {
+    if view.w == 0 || view.h == 0 {
+        return None;
+    }
+    let repeated = |coordinate: f32, extent: u32| {
+        let unit = repeat_unit(coordinate);
+        let fixed = (unit * extent as f32 * 256.0) as i32 - 128;
+        let base = fixed >> 8;
+        let first = base.rem_euclid(extent as i32) as u32;
+        let second = (first + 1) % extent;
+        (first, second, (fixed & 255) as u32)
+    };
+    let (x0, x1, fx) = repeated(u, view.w);
+    let (y0, y1, fy) = repeated(v, view.h);
+    let width = view.w as usize;
+    let c00 = texel(view, y0 as usize * width + x0 as usize)?;
+    let c01 = texel(view, y0 as usize * width + x1 as usize)?;
+    let c10 = texel(view, y1 as usize * width + x0 as usize)?;
+    let c11 = texel(view, y1 as usize * width + x1 as usize)?;
