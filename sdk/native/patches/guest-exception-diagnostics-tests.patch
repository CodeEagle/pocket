+        let frame = GuestFrame {
+            buttons: 0,
+            analog: 0,
+            touches: &[],
+            hits: &[],
+            touch_surfaces: &[],
+            right_analog: 0,
+            axis_deltas: &[],
+            motion: None,
+            text: &[],
+        };
+        assert_eq!(guest.frame(&frame), Err(RuntimeError::Guest));
+        let detail = guest.last_error().unwrap();
+        assert!(detail.contains("execution interrupted by budget"), "{detail}");
+    }
