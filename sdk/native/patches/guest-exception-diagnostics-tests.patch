+    #[test]
+    fn pending_job_exception_preserves_message_and_stack() {
+        unsafe extern "C" fn throw_job(
+            ctx: *mut qjs::JSContext,
+            _argc: i32,
+            _argv: *mut qjs::JSValue,
+        ) -> qjs::JSValue {
+            static SOURCE: &[u8] = b"throw new Error('job diagnostics')\0";
+            static FILE: &[u8] = b"pending-job.js\0";
+            unsafe {
+                qjs::JS_Eval(
+                    ctx,
+                    SOURCE.as_ptr().cast(),
+                    SOURCE.len() as u64 - 1,
+                    FILE.as_ptr().cast(),
+                    qjs::JS_EVAL_TYPE_GLOBAL as i32,
+                )
+            }
+        }
+        let (mut guest, _) = guest(BindingProfile::Canonical);
+        guest.begin_turn(Duration::from_millis(250));
+        guest
+            .with(|ctx| unsafe {
+                assert_eq!(
+                    qjs::JS_EnqueueJob(
+                        ctx.as_raw().as_ptr(),
+                        Some(throw_job),
+                        0,
+                        std::ptr::null_mut(),
+                    ),
+                    0
+                );
+            })
+            .unwrap();
+        assert_eq!(guest.collect(), Err(RuntimeError::Guest));
+        let detail = guest.last_error().unwrap();
+        assert!(detail.contains("job diagnostics"), "{detail}");
+        assert!(detail.contains("stack:"), "{detail}");
+    }
