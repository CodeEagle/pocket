+        if !world.is_axis_aligned() || world.a != world.d { return false; }
+        let (sx0, sy0) = world.apply(x0, y0);
+        let (sx1, sy1) = world.apply(x1, y1);
+        let (w, h, scale) = (sx1 - sx0, sy1 - sy0, world.a);
+        if ![sx0, sy0, w, h, scale, radius, border_width].iter().all(|v| v.is_finite())
+            || w <= 0.0 || h <= 0.0 || scale <= 0.0 || radius <= 0.0 { return false; }
+        let radius = (radius * scale).min(w * 0.5).min(h * 0.5);
+        let border_width = (border_width * scale).max(0.0).min(w * 0.5).min(h * 0.5);
+        if !radius.is_finite() || !border_width.is_finite() { return false; }
+        if sx1 + 1.0 <= clip.x0 || sx0 - 1.0 >= clip.x1 || sy1 + 1.0 <= clip.y0 || sy0 - 1.0 >= clip.y1 { return true; }
