+#[test]
+fn native_rounded_rects_are_opt_in_and_preserve_ring_compositing() {
+    fn add_shape(ui: &mut Ui, fill: bool, border: bool) {
+        let n = ui.create_node(0);
+        for (prop, value) in [
+            (spec::prop::WIDTH, 220.0), (spec::prop::HEIGHT, 220.0),
+            (spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64),
+            (spec::prop::INSET_L, 12.0), (spec::prop::INSET_T, 14.0), (spec::prop::RADIUS, 95.0),
+        ] { ui.set_prop(n, prop, value); }
+        if fill { ui.set_prop(n, spec::prop::BG_COLOR, 0xff223344u32 as f64); }
+        if border {
+            ui.set_prop(n, spec::prop::BORDER_WIDTH, 6.0);
+            ui.set_prop(n, spec::prop::BORDER_COLOR, 0xffaabbccu32 as f64);
+        }
+        ui.insert_before(spec::ROOT_ID, n, 0);
+        ui.tick();
+    }
+    let mut ui = Ui::new();
+    add_shape(&mut ui, true, false);
+    assert_eq!(validate_drawlist(&ui.draw().words.clone())[spec::draw_op::ROUNDED_RECT as usize], 0);
+    ui.set_native_rounded_rects(true);
+    let fill = ui.draw().words.clone();
+    assert_eq!(validate_drawlist(&fill)[spec::draw_op::ROUNDED_RECT as usize], 1);
+    let at = fill.iter().position(|&word| word == spec::draw_op::ROUNDED_RECT).unwrap();
+    assert_eq!(f32::from_bits(fill[at + 5]), 95.0);
+    assert_eq!(f32::from_bits(fill[at + 6]), 0.0);
+    assert_eq!(fill[at + 7], 0xff223344);
+
+    let mut ring_ui = Ui::new();
+    add_shape(&mut ring_ui, false, true);
+    ring_ui.set_native_rounded_rects(true);
+    let ring = ring_ui.draw().words.clone();
+    assert_eq!(validate_drawlist(&ring)[spec::draw_op::ROUNDED_RECT as usize], 1);
+    let at = ring.iter().position(|&word| word == spec::draw_op::ROUNDED_RECT).unwrap();
+    assert_eq!(f32::from_bits(ring[at + 5]), 95.0);
+    assert_eq!(f32::from_bits(ring[at + 6]), 6.0);
+    assert_eq!(ring[at + 7], 0xffaabbcc);
+
+    let mut composite_ui = Ui::new();
+    add_shape(&mut composite_ui, true, true);
+    composite_ui.set_native_rounded_rects(true);
+    let composite = composite_ui.draw().words.clone();
+    assert_eq!(validate_drawlist(&composite)[spec::draw_op::ROUNDED_RECT as usize], 2);
+    let paints: Vec<_> = composite.iter().enumerate()
+        .filter(|(_, word)| **word == spec::draw_op::ROUNDED_RECT)
+        .map(|(at, _)| (f32::from_bits(composite[at + 6]), composite[at + 7]))
+        .collect();
+    assert_eq!(paints, [(0.0, 0xffaabbcc), (0.0, 0xff223344)]);
 }
 
