+fn rounded_rect_bounds(words: &[u32], clip: DamageRect) -> DamageRect {
+    let values = [1usize, 2, 3, 4].map(|index| f32::from_bits(words[index]));
+    let [x, y, w, h] = values;
+    if !values.iter().all(|value| value.is_finite()) || w <= 0.0 || h <= 0.0 { return clip; }
+    let bounds = [x - 1.0, y - 1.0, x + w + 1.0, y + h + 1.0];
+    if !bounds.iter().all(|value| value.is_finite()) { return clip; }
+    DamageRect::new(floor_i32(bounds[0]), floor_i32(bounds[1]), ceil_i32(bounds[2]), ceil_i32(bounds[3])).intersect(clip)
+}
