 #[test]
+fn native_rounded_gradients_preserve_stops_directions_and_composition() {
+    fn draw_gradient(
+        direction: u32,
+        native: bool,
+        radius: f64,
+        scale_x: f64,
+        rotate: f64,
+        border: bool,
+        shadow: u32,
+        via_position: Option<f64>,
+        gradient: bool,
+    ) -> Vec<u32> {
+        let mut ui = Ui::new();
+        ui.set_viewport(240.0, 160.0);
+        let node = ui.create_node(0);
+        let from = abgr(20, 40, 60, 100);
+        let via = abgr(240, 230, 220, 150);
+        let to = abgr(80, 100, 120, 220);
+        for (prop, value) in [
+            (spec::prop::WIDTH, 80.0),
+            (spec::prop::HEIGHT, 60.0),
+            (spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64),
+            (spec::prop::INSET_L, 20.0),
+            (spec::prop::INSET_T, 20.0),
+            (spec::prop::RADIUS, radius),
+            (spec::prop::OPACITY, 0.5),
+            (spec::prop::SCALE_X, scale_x),
+            (spec::prop::ROTATE, rotate),
+            (spec::prop::SHADOW, shadow as f64),
+        ] {
+            ui.set_prop(node, prop, value);
+        }
+        if gradient {
+            for (prop, value) in [
+                (spec::prop::GRAD_FROM, from as f64),
+                (spec::prop::GRAD_VIA, via as f64),
+                (spec::prop::GRAD_TO, to as f64),
+                (spec::prop::GRAD_DIR, direction as f64),
+            ] {
+                ui.set_prop(node, prop, value);
+            }
+            if let Some(position) = via_position {
+                ui.set_prop(node, spec::prop::GRAD_VIA_POS, position);
+            }
+        } else {
+            ui.set_prop(node, spec::prop::BG_COLOR, from as f64);
+        }
+        if border {
+            ui.set_prop(node, spec::prop::BORDER_COLOR, abgr(10, 20, 30, 255) as f64);
+            ui.set_prop(node, spec::prop::BORDER_WIDTH, 4.0);
+        }
+        ui.insert_before(spec::ROOT_ID, node, 0);
+        ui.tick();
+        ui.set_native_rounded_rects(native);
+        ui.draw().words.clone()
+    }
+
+    let from = abgr(20, 40, 60, 50);
+    let via = abgr(240, 230, 220, 75);
+    let to = abgr(80, 100, 120, 110);
+    for direction in 0..=3 {
+        let words = draw_gradient(direction, true, 12.0, 1.0, 0.0, false, 0, Some(0.35), true);
+        let counts = validate_drawlist(&words);
+        assert_eq!(counts[spec::draw_op::ROUNDED_GRADIENT as usize], 1);
+        assert_eq!(counts[spec::draw_op::GRAD_RECT as usize], 0);
+        assert_eq!(counts[spec::draw_op::TEX_QUAD as usize], 0);
+        assert_eq!(words[0], spec::draw_op::ROUNDED_GRADIENT);
+        assert_eq!(
+            [
+                f32::from_bits(words[1]),
+                f32::from_bits(words[2]),
+                f32::from_bits(words[3]),
+                f32::from_bits(words[4]),
+                f32::from_bits(words[5]),
+            ],
+            [20.0, 20.0, 80.0, 60.0, 12.0],
+        );
+        assert_eq!(&words[6..10], &[from, to, direction, via]);
+        assert_eq!(f32::from_bits(words[10]), 0.35);
+    }
+
+    let mut clipped_ui = Ui::new();
+    clipped_ui.set_viewport(60.0, 60.0);
+    let clipped_node = clipped_ui.create_node(0);
+    for (prop, value) in [
+        (spec::prop::WIDTH, 80.0),
+        (spec::prop::HEIGHT, 40.0),
+        (spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64),
+        (spec::prop::INSET_L, -20.0),
+        (spec::prop::INSET_T, 10.0),
+        (spec::prop::RADIUS, 12.0),
+        (spec::prop::GRAD_FROM, abgr(0, 0, 0, 255) as f64),
+        (spec::prop::GRAD_TO, abgr(255, 255, 255, 255) as f64),
+        (spec::prop::GRAD_DIR, spec::GradDir::ToRight as u32 as f64),
+    ] {
+        clipped_ui.set_prop(clipped_node, prop, value);
+    }
+    clipped_ui.insert_before(spec::ROOT_ID, clipped_node, 0);
+    clipped_ui.tick();
+    clipped_ui.set_native_rounded_rects(true);
+    let clipped_words = clipped_ui.draw().words.clone();
+    let clipped_at = clipped_words
+        .iter()
+        .position(|&word| word == spec::draw_op::ROUNDED_GRADIENT)
+        .unwrap();
+    assert_eq!(f32::from_bits(clipped_words[clipped_at + 1]), -20.0);
+    assert_eq!(f32::from_bits(clipped_words[clipped_at + 2]), 10.0);
+    assert_eq!(f32::from_bits(clipped_words[clipped_at + 3]), 80.0);
+    assert_eq!(f32::from_bits(clipped_words[clipped_at + 4]), 40.0);
+
+    let two_stop = draw_gradient(3, true, 12.0, 1.0, 0.0, false, 0, None, true);
+    assert_eq!(validate_drawlist(&two_stop)[spec::draw_op::ROUNDED_GRADIENT as usize], 1);
+    assert!(f32::from_bits(two_stop[10]).is_nan(), "NaN is the only no-middle-stop sentinel");
+    let endpoint_stop = draw_gradient(3, true, 12.0, 1.0, 0.0, false, 0, Some(0.0), true);
+    assert!(f32::from_bits(endpoint_stop[10]).is_nan(), "endpoint stops retain two-stop behavior");
+
+    let legacy = draw_gradient(3, false, 12.0, 1.0, 0.0, false, 0, Some(0.35), true);
+    assert_eq!(validate_drawlist(&legacy)[spec::draw_op::ROUNDED_GRADIENT as usize], 0);
+    let nonuniform = draw_gradient(3, true, 12.0, 1.5, 0.0, false, 0, Some(0.35), true);
+    assert_eq!(validate_drawlist(&nonuniform)[spec::draw_op::ROUNDED_GRADIENT as usize], 0);
+    let rotated = draw_gradient(3, true, 12.0, 1.0, 0.25, false, 0, Some(0.35), true);
+    assert_eq!(validate_drawlist(&rotated)[spec::draw_op::ROUNDED_GRADIENT as usize], 0);
+    let square = draw_gradient(3, true, 0.0, 1.0, 0.0, false, 0, Some(0.35), true);
+    assert_eq!(validate_drawlist(&square)[spec::draw_op::ROUNDED_GRADIENT as usize], 0);
+    let subpixel = draw_gradient(3, true, 0.4, 1.0, 0.0, false, 0, Some(0.35), true);
+    assert_eq!(validate_drawlist(&subpixel)[spec::draw_op::ROUNDED_GRADIENT as usize], 0);
+    let flat = draw_gradient(3, true, 12.0, 1.0, 0.0, false, 0, None, false);
+    assert_eq!(validate_drawlist(&flat)[spec::draw_op::ROUNDED_GRADIENT as usize], 0);
+    assert_eq!(validate_drawlist(&flat)[spec::draw_op::ROUNDED_RECT as usize], 1);
+
+    let bordered = draw_gradient(2, true, 12.0, 1.0, 0.0, true, 0, Some(0.35), true);
+    assert_eq!(validate_drawlist(&bordered)[spec::draw_op::ROUNDED_RECT as usize], 1);
+    assert_eq!(validate_drawlist(&bordered)[spec::draw_op::ROUNDED_GRADIENT as usize], 1);
+    assert_eq!(bordered[0], spec::draw_op::ROUNDED_RECT);
+    assert_eq!(bordered[8], spec::draw_op::ROUNDED_GRADIENT);
+    assert_eq!(f32::from_bits(bordered[8 + 1]), 24.0);
+    assert_eq!(f32::from_bits(bordered[8 + 2]), 24.0);
+    assert_eq!(f32::from_bits(bordered[8 + 3]), 72.0);
+    assert_eq!(f32::from_bits(bordered[8 + 4]), 52.0);
+    assert_eq!(f32::from_bits(bordered[8 + 5]), 8.0);
+
+    let shadowed = draw_gradient(1, true, 12.0, 1.0, 0.0, false, 1, Some(0.35), true);
+    let shadow_counts = validate_drawlist(&shadowed);
+    assert!(shadow_counts[spec::draw_op::RECT as usize] > 0);
+    assert_eq!(shadow_counts[spec::draw_op::ROUNDED_RECT as usize], 0);
+    assert_eq!(shadow_counts[spec::draw_op::ROUNDED_GRADIENT as usize], 1);
+    let gradient_at = shadowed.iter().rposition(|&word| word == spec::draw_op::ROUNDED_GRADIENT).unwrap();
+    assert_eq!(gradient_at + 11, shadowed.len(), "legacy shadow layers remain before the gradient fill");
+}
