+fn software_surface_rejects_native_shape_ops_before_writing() {
+    let resources = Resources::fixture();
+    let records = [
+        vec![
+            draw_op::ROUNDED_RECT,
+            1.0f32.to_bits(),
+            1.0f32.to_bits(),
+            5.0f32.to_bits(),
+            4.0f32.to_bits(),
+            2.0f32.to_bits(),
+            0.0f32.to_bits(),
+            0xff12_3456,
+        ],
+        vec![
+            draw_op::ARC,
+            4.0f32.to_bits(),
+            3.0f32.to_bits(),
+            2.0f32.to_bits(),
+            1.0f32.to_bits(),
+            0.0f32.to_bits(),
+            90.0f32.to_bits(),
+            0xff12_3456,
+        ],
+        vec![
+            draw_op::ROUNDED_GRADIENT,
+            1.0f32.to_bits(),
+            1.0f32.to_bits(),
+            5.0f32.to_bits(),
+            4.0f32.to_bits(),
+            2.0f32.to_bits(),
+            0xff12_3456,
+            0xffab_cdef,
+            0,
+            0,
+            f32::NAN.to_bits(),
+        ],
+    ];
+
+    for words in records {
+        assert_eq!(
+            validate_supported_draw_list(&resources, &words),
+            Err(RenderError::Unsupported)
+        );
+
+        let decoded = DrawOps::new(&words, DamageRect::new(0, 0, 8, 6))
+            .next()
+            .unwrap()
+            .unwrap();
+
+        let mut operation_pixels = [0x37; 8 * 6 * 4];
+        let mut operation_surface = Surface::new(
+            &mut operation_pixels,
+            Rect::new(0, 0, 8, 6),
+            8 * 4,
+            PixelFormat::Rgba8888,
+        )
+        .unwrap();
+        assert_eq!(
+            render_operation(&resources, &decoded, &mut operation_surface, 1),
+            Err(RenderError::Unsupported)
+        );
+        drop(operation_surface);
+        assert!(operation_pixels.iter().all(|byte| *byte == 0x37));
+
+        let mut pixels = [0x37; 8 * 6 * 4];
+        let mut surface = Surface::new(
+            &mut pixels,
+            Rect::new(0, 0, 8, 6),
+            8 * 4,
+            PixelFormat::Rgba8888,
+        )
+        .unwrap();
+        assert_eq!(
+            render_surface(&resources, &words, &mut surface, 1),
+            Err(RenderError::Unsupported)
+        );
+        assert!(pixels.iter().all(|byte| *byte == 0x37));
+    }
+}
