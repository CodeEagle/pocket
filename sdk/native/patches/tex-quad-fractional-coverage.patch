+
+/// Pack a textured quad from the same quantized edges used by `xy_word`.
+///
+/// TEX_QUAD boxes are often adjacent (DeepZoom tiles, sprites, and atlas
+/// cells).  Rounding the origin and the extent independently can leave a
+/// one-pixel hole when a transformed edge is fractional: `round(x0) +
+/// round(x1 - x0)` need not cover `round(x1)`.  Keep the existing rounded
+/// origin for compatibility, but round the far edge and derive the extent from
+/// those two shared edges.  Adjacent quads therefore use the exact same
+/// quantized boundary: there is no hole and no extra overdraw at the seam.
+#[inline]
+fn tex_quad_wh(x0: f32, y0: f32, x1: f32, y1: f32) -> u32 {
+    let qx0 = roundf(x0);
+    let qy0 = roundf(y0);
+    let qx1 = roundf(x1);
+    let qy1 = roundf(y1);
+    let wi = (qx1 - qx0).max(0.0) as i32 as u16 as u32;
+    let hi = (qy1 - qy0).max(0.0) as i32 as u16 as u32;
     wi | (hi << 16)
 }
 
