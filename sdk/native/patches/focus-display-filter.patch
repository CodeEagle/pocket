+/**
+ * A retained route is still connected in the JS mirror, but its route slot
+ * carries the official inline `display: Display.None` style. The native
+ * renderer already omits that subtree from layout, paint and hit testing;
+ * keep keyboard focus semantics aligned with the same boundary. Classes are
+ * deliberately not inspected here: RouteView owns an inline display prop,
+ * which is the stable cross-host signal available in NodeMirror.
+ */
+function isDisplayNone(node: NodeMirror | null): boolean {
+  let current = node;
+  while (current) {
+    const style = current.domAttrs?.style;
+    if (style && typeof style === "object") {
+      const display = (style as Record<string, unknown>).display;
+      if (display === 1 || display === "none") return true;
+    }
+    current = current.parent;
+  }
+  return false;
+}
