+/// Retained mesh triangles keep subpixel logical-pixel positions. Ordinary
+/// rotated image quads continue using the legacy packed-i16 TEX_TRI format.
+fn emit_mesh_tex_tri(
+    dl: &mut DrawList,
+    tex: u32,
+    modulate: u32,
+    v0: &ClipVert,
+    v1: &ClipVert,
+    v2: &ClipVert,
+    clip: &Clip,
+    screen: (f32, f32),
+    repeat_texture: bool,
+) {
+    let px = |v: &ClipVert| {
+        (
+            clampf(clampf(v.x, clip.x0, clip.x1), 0.0, screen.0),
+            clampf(clampf(v.y, clip.y0, clip.y1), 0.0, screen.1),
+        )
+    };
+    let (x0, y0) = px(v0);
+    let (x1, y1) = px(v1);
+    let (x2, y2) = px(v2);
+    let area2 = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0);
+    if area2 == 0.0 || !area2.is_finite() {
+        return;
+    }
+    dl.words.push(if repeat_texture {
+        spec::draw_op::TEX_TRI_REPEAT_FLOAT
+    } else {
+        spec::draw_op::TEX_TRI_FLOAT
+    });
+    dl.words.push(tex);
+    for ((x, y), vert) in [((x0, y0), v0), ((x1, y1), v1), ((x2, y2), v2)] {
+        dl.words.push(x.to_bits());
+        dl.words.push(y.to_bits());
+        dl.words.push(vert.u.to_bits());
+        dl.words.push(vert.v.to_bits());
+    }
+    dl.words.push(modulate);
+}
