+// ---- TEX_TRI_FLOAT: subpixel barycentric mesh triangle --------------------
+
+fn tex_tri_float<T: RenderTarget>(
+    ui: &(impl RenderResources + ?Sized),
+    target: &mut T,
+    stride: i32,
+    scale: i32,
+    clip: Clip,
+    p: &[u32],
+) {
+    let handle = p[0] as i32;
+    let scale = scale as f32;
+    let (mut x0, mut y0) = (f32::from_bits(p[1]) * scale, f32::from_bits(p[2]) * scale);
+    let (mut u0, mut v0) = (f32::from_bits(p[3]), f32::from_bits(p[4]));
+    let (mut x1, mut y1) = (f32::from_bits(p[5]) * scale, f32::from_bits(p[6]) * scale);
+    let (mut u1, mut v1) = (f32::from_bits(p[7]), f32::from_bits(p[8]));
+    let (mut x2, mut y2) = (f32::from_bits(p[9]) * scale, f32::from_bits(p[10]) * scale);
+    let (mut u2, mut v2) = (f32::from_bits(p[11]), f32::from_bits(p[12]));
+    let modulate = p[13];
+    if [x0, y0, x1, y1, x2, y2, u0, v0, u1, v1, u2, v2]
+        .iter()
+        .any(|value| !value.is_finite())
+    {
+        return;
+    }
+    let Some(view) = ui.texture(handle) else {
+        return;
+    };
+    // Compute edge equations in f64. Source vertices are f32, so this gives
+    // exact antisymmetric edge values for opposite directions of a shared
+    // edge and avoids double-blending that edge between adjacent triangles.
+    let orient = |ax: f32, ay: f32, bx: f32, by: f32, px: f32, py: f32| {
+        (bx as f64 - ax as f64) * (py as f64 - ay as f64)
+            - (by as f64 - ay as f64) * (px as f64 - ax as f64)
+    };
+    let top_left = |ax: f32, ay: f32, bx: f32, by: f32| {
+        let dx = bx - ax;
+        let dy = by - ay;
+        dy < 0.0 || (dy == 0.0 && dx > 0.0)
+    };
+    let mut area = orient(x0, y0, x1, y1, x2, y2);
+    if area == 0.0 {
+        return;
+    }
+    if area < 0.0 {
+        core::mem::swap(&mut x1, &mut x2);
+        core::mem::swap(&mut y1, &mut y2);
+        core::mem::swap(&mut u1, &mut u2);
+        core::mem::swap(&mut v1, &mut v2);
+        area = -area;
+    }
+    // Bounds are finite above. Rust's float cast truncates toward zero;
+    // correct the fractional side without adding a no_std math dependency.
+    let floor_bound = |value: f32| {
+        let integer = value as i32;
+        if integer as f32 > value { integer.saturating_sub(1) } else { integer }
+    };
+    let ceil_bound = |value: f32| {
+        let integer = value as i32;
+        if (integer as f32) < value { integer.saturating_add(1) } else { integer }
+    };
+    let min_x = floor_bound(x0.min(x1).min(x2));
+    let max_x = ceil_bound(x0.max(x1).max(x2));
+    let min_y = floor_bound(y0.min(y1).min(y2));
+    let max_y = ceil_bound(y0.max(y1).max(y2));
+    let (min_x, max_x) = (min_x.max(clip.x0), max_x.min(clip.x1));
+    let (min_y, max_y) = (min_y.max(clip.y0), max_y.min(clip.y1));
+    let (mr, mg, mb, ma) = channels(modulate);
+    let identity = modulate == 0xffff_ffff;
+    let (twf, thf) = (view.w as f32, view.h as f32);
+    let (tw_max, th_max) = (view.w as i32 - 1, view.h as i32 - 1);
+    for py in min_y..max_y {
+        let sy = py as f32 + 0.5;
+        for px in min_x..max_x {
+            let sx = px as f32 + 0.5;
+            let w0 = orient(x1, y1, x2, y2, sx, sy);
+            let w1 = orient(x2, y2, x0, y0, sx, sy);
+            let w2 = orient(x0, y0, x1, y1, sx, sy);
+            if w0 < 0.0
+                || (w0 == 0.0 && !top_left(x1, y1, x2, y2))
+                || w1 < 0.0
+                || (w1 == 0.0 && !top_left(x2, y2, x0, y0))
+                || w2 < 0.0
+                || (w2 == 0.0 && !top_left(x0, y0, x1, y1))
+            {
+                continue;
+            }
+            let (f0, f1, f2) = ((w0 / area) as f32, (w1 / area) as f32, (w2 / area) as f32);
+            let (u, v) = (u0 * f0 + u1 * f1 + u2 * f2, v0 * f0 + v1 * f1 + v2 * f2);
+            let sample = if view.linear {
+                sample_linear(&view, u, v)
+            } else {
+                let tx = ((u * twf) as i32).clamp(0, tw_max);
+                let ty = ((v * thf) as i32).clamp(0, th_max);
+                texel(&view, (ty * view.w as i32 + tx) as usize)
+            };
+            let Some((mut r, mut g, mut b, mut a)) = sample else {
+                return;
+            };
+            if !identity {
+                r = (r * mr + 127) / 255;
+                g = (g * mg + 127) / 255;
+                b = (b * mb + 127) / 255;
+                a = (a * ma + 127) / 255;
+            }
+            target.blend((py * stride + px) as usize, r, g, b, a);
+        }
+    }
 }
 
