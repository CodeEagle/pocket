+// Native hosts query this after each guest turn to decide whether the next
+// frame is event-driven, continuous, or can sleep until an `after()` deadline.
+
+import { __skipIdleClockFrames, framesUntilNextTimer, simulationHz } from "./clock.ts";
+import { hasContinuousFrameWork } from "./frame-dispatch.ts";
+import { hasPendingEffects } from "./effects.ts";
+import { hasPendingModelAnimations } from "./model-animation.ts";
+import { hasPendingModelTasks } from "./model-tasks.ts";
+import { hasPendingServiceWork } from "./services.ts";
+import { hasPendingGestureWork } from "./gesture-core.ts";
+
+export interface PocketWorkState {
+  version: 1;
+  continuous: boolean;
+  framesUntilTimer: number | null;
+  simulationHz: number;
+}
+
+export function getPocketWorkState(): PocketWorkState {
+  return {
+    version: 1,
+    continuous:
+      hasContinuousFrameWork() ||
+      hasPendingEffects() ||
+      hasPendingModelTasks() ||
+      hasPendingModelAnimations() ||
+      hasPendingServiceWork() ||
+      hasPendingGestureWork(),
+    framesUntilTimer: framesUntilNextTimer(),
+    simulationHz: simulationHz(),
+  };
+}
+
+/**
+ * Fast-forward only clock-only idle frames. Active JS work refuses the skip;
+ * the clock helper caps it before the earliest timer callback is due.
+ */
+export function skipPocketIdleFrames(requested: number): number {
+  if (getPocketWorkState().continuous) return 0;
+  return __skipIdleClockFrames(requested);
+}
+
+type SchedulerGlobals = typeof globalThis & {
+  __pocketWorkState?: () => PocketWorkState;
+  __pocketSkipIdleFrames?: (frames: number) => number;
+};
+
+const schedulerGlobals = globalThis as SchedulerGlobals;
+schedulerGlobals.__pocketWorkState = getPocketWorkState;
+schedulerGlobals.__pocketSkipIdleFrames = skipPocketIdleFrames;
