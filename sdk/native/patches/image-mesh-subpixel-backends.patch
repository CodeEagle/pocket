+    };
+    let uv = |vertex: usize| {
+        let offset = vertex * core::mem::size_of::<VertTC>();
+        (
+            i16::from_ne_bytes([bytes[offset], bytes[offset + 1]]),
+            i16::from_ne_bytes([bytes[offset + 2], bytes[offset + 3]]),
+        )
+    };
