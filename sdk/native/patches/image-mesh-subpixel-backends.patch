+#[test]
+fn float_textured_triangle_keeps_subpixel_coverage_on_gpu() {
+    let gpu = Gpu::new();
+    let mut renderer = gpu.renderer();
+    let output = gpu.output();
+    let target = gpu.register(&mut renderer, &output);
+    let resources = Resources::red();
+    let token = render(&mut renderer, target, &float_triangle(), &resources).unwrap();
+    renderer.wait(&token).unwrap();
+    renderer.retire(token);
+    let pixels = gpu.read(&output);
+    let pixel = |x: usize, y: usize| &pixels[(y * 4 + x) * 4..(y * 4 + x + 1) * 4];
+    assert_eq!(pixel(3, 0), [255, 0, 0, 255]);
+    assert_eq!(pixel(3, 3), [0, 0, 0, 255]);
+}
