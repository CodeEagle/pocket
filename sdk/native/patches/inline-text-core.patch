+#[test]
+fn inline_text_one_core_layout_paints_runs_ruby_and_revealed_multiline_links() {
+    use std::{cell::Cell, rc::Rc};
+    let calls = Rc::new(Cell::new(0u32));
+    let calls_in_measure = calls.clone();
+    let mut ui = Ui::new();
+    ui.set_text_measure(Some(alloc::boxed::Box::new(move |text: &str, slot, _tracking, line_h| {
+        calls_in_measure.set(calls_in_measure.get() + 1);
+        let default_h = if slot == 2 { 6.0 } else { 12.0 };
+        let height = if line_h.is_nan() { default_h } else { line_h };
+        (text.chars().count() as f32 * 7.0, height)
+    })));
+    let text = ui.create_node(spec::NodeType::Text as u8);
+    ui.set_prop(text, spec::prop::WIDTH, 14.0);
+    ui.set_prop(text, spec::prop::TEXT_COLOR, u32::MAX as f64);
+    ui.set_inline_text(text, "ABCD", &inline_records(Some(u32::MAX)));
+    ui.set_inline_reveal(text, 0);
+    ui.insert_before(spec::ROOT_ID, text, 0);
+
+    let initial = ui.get_inline_text_layout(text);
+    assert_eq!(f32::from_bits(initial[0]), 14.0);
+    assert_eq!(f32::from_bits(initial[1]), 30.0, "ruby lane is reserved in line one");
+    assert_eq!(initial[2], 2);
+    assert_eq!(initial[3], 0, "links stay hidden before full reveal");
+    let shaped_calls = calls.get();
+
+    ui.set_inline_reveal(text, 1);
+    let partial = ui.get_inline_text_layout(text);
+    assert_eq!(f32::from_bits(partial[1]), 30.0, "reveal does not change full paragraph geometry");
+    assert_eq!(partial[3], 0, "ruby base and link remain partially hidden");
+    let partial_words = ui.draw().words.clone();
+    let partial_at = partial_words.iter().position(|&word| word == spec::draw_op::TEXT_RUN).unwrap();
+    assert_eq!(decode_text_run_text(&partial_words, partial_at).0, "A");
+    assert_eq!(calls.get(), shaped_calls, "reveal only changes paint; it does not remeasure");
+
+    ui.set_inline_reveal(text, 2);
+    let ruby_ready = ui.get_inline_text_layout(text);
+    assert_eq!(f32::from_bits(ruby_ready[1]), 30.0);
+    assert_eq!(ruby_ready[3], 0, "link spans both lines and is not ready yet");
+    let ruby_words = ui.draw().words.clone();
+    let text_ops: Vec<usize> = ruby_words.iter().enumerate()
+        .filter_map(|(index, &word)| (word == spec::draw_op::TEXT_RUN).then_some(index)).collect();
+    assert_eq!(text_ops.len(), 2, "one run for the styled base, one for ruby");
+    let (base, _) = decode_text_run_text(&ruby_words, text_ops[0]);
+    let (ruby, _) = decode_text_run_text(&ruby_words, text_ops[1]);
+    assert_eq!((base.as_str(), ruby.as_str()), ("AB", "ru"));
+    assert_eq!(ruby_words[text_ops[0] + 1] & 0xff, 1, "base uses explicit bold slot");
+    assert_eq!(ruby_words[text_ops[0] + 6], 0xff11_2233, "base uses explicit ABGR color");
+    assert_eq!(ruby_words[text_ops[1] + 1] & 0xff, 2, "ruby uses its smaller font slot");
+    assert_eq!(ruby_words[text_ops[1] + 6], u32::MAX, "explicit white ruby color does not inherit the base color");
+    assert!(f32::from_bits(ruby_words[text_ops[1] + 3]) < f32::from_bits(ruby_words[text_ops[0] + 3]),
+        "ruby paints above its base");
+    assert_eq!(calls.get(), shaped_calls, "painted partial text reuses Core's full-source metrics");
+
+    ui.set_inline_reveal(text, 4);
