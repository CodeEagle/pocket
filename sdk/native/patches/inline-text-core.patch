--- /dev/null
+++ b/engine/core/src/inline_text.rs
@@ -0,0 +1,256 @@
+//! One-leaf rich inline layout. Source ranges are Unicode scalar offsets.
+//! This deliberately supports scalar advances and simple CJK/Latin wrapping;
+//! complex-script shaping remains the responsibility of a future shaper.
+
+use alloc::string::ToString;
+use alloc::vec::Vec;
+
+use crate::text::Fonts;
+use crate::tree::{InlineFragment, InlineRubyFragment, InlineTextLayout, InlineTextSpec};
+
+#[derive(Clone)]
+struct Token {
+    start: u32,
+    end: u32,
+    width: f32,
+    font_slot: u8,
+    color: Option<u32>,
+    link_id: u32,
+    ruby: Option<crate::tree::InlineRuby>,
+    ruby_height: f32,
+    newline: bool,
+    whitespace: bool,
+    cjk: bool,
+}
+
+pub fn source_slice(source: &str, start: u32, end: u32) -> &str {
+    let mut first = source.len();
+    let mut last = source.len();
+    for (index, (byte, _)) in source.char_indices().enumerate() {
+        if index as u32 == start { first = byte; }
+        if index as u32 == end { last = byte; break; }
+    }
+    if end as usize == source.chars().count() { last = source.len(); }
+    if start == end { first = last; }
+    &source[first.min(source.len())..last.min(source.len()).max(first.min(source.len()))]
+}
+
+fn cjk(cp: u32) -> bool {
+    matches!(cp,
+        0x2e80..=0x2fff | 0x3000..=0x30ff | 0x3100..=0x312f |
+        0x3130..=0x318f | 0x31a0..=0x31bf | 0x31f0..=0x31ff |
+        0x3400..=0x4dbf | 0x4e00..=0x9fff | 0xf900..=0xfaff |
+        0xff01..=0xff60 | 0xffe0..=0xffe6 | 0x20000..=0x3134f)
+}
+
+fn advance(fonts: &Fonts, native: bool, text: &str, slot: u8, tracking: f32, line_height: f32) -> (f32, f32) {
+    let (width, height) = fonts.measure_run_provider(native, text, slot, tracking, line_height);
+    if width.is_finite() && width >= 0.0 { (width, height.max(0.0)) } else { (0.0, height.max(0.0)) }
+}
+
+/// Computes the full paragraph once. Reveal progress is intentionally absent
+/// from the cache key and does not participate in this function.
+pub fn layout(
+    source: &str,
+    spec: &InlineTextSpec,
+    base_slot: u8,
+    max_width: f32,
+    tracking: f32,
+    line_height: f32,
+    native: bool,
+    fonts: &Fonts,
+) -> InlineTextLayout {
+    let scalar_count = source.chars().count() as u32;
+    let mut tokens: Vec<Token> = Vec::with_capacity(scalar_count as usize);
+    let mut cursor = 0u32;
+    let mut run_index = 0usize;
+    let chars: Vec<char> = source.chars().collect();
+    while cursor < scalar_count {
+        while run_index < spec.runs.len() && spec.runs[run_index].end <= cursor { run_index += 1; }
+        let run = spec.runs.get(run_index).filter(|run| run.start <= cursor && cursor < run.end);
+        if let Some(ruby) = run.and_then(|run| run.ruby.as_ref()) {
+            let end = run.unwrap().end.min(scalar_count);
+            let slot = run.unwrap().font_slot.unwrap_or(base_slot);
+            let text = source_slice(source, cursor, end);
+            let (base_width, _) = advance(fonts, native, text, slot, tracking, line_height);
+            let ruby_slot = ruby.font_slot.unwrap_or(base_slot);
+            let (ruby_width, ruby_height) = advance(fonts, native, &ruby.text, ruby_slot, 0.0, f32::NAN);
+            tokens.push(Token {
+                start: cursor, end, width: base_width.max(ruby_width), font_slot: slot,
+                color: run.unwrap().color, link_id: run.unwrap().link_id, ruby: Some(ruby.clone()),
+                ruby_height, newline: false, whitespace: false, cjk: false,
+            });
+            cursor = end;
+            continue;
+        }
+        let ch = chars[cursor as usize];
+        let slot = run.and_then(|run| run.font_slot).unwrap_or(base_slot);
+        let one = ch.to_string();
+        let (width, _) = if ch == '\n' { (0.0, 0.0) } else {
+            advance(fonts, native, &one, slot, tracking, line_height)
+        };
+        tokens.push(Token {
+            start: cursor, end: cursor + 1, width, font_slot: slot,
+            color: run.and_then(|run| run.color), link_id: run.map_or(0, |run| run.link_id),
+            ruby: None, ruby_height: 0.0,
+            newline: ch == '\n', whitespace: ch.is_whitespace(), cjk: cjk(ch as u32),
+        });
+        cursor += 1;
+    }
+
+    let wrap_width = if max_width.is_finite() && max_width > 0.0 { max_width } else { f32::INFINITY };
+    let mut lines: Vec<Vec<Token>> = alloc::vec![Vec::new()];
+    let mut line_width = 0.0f32;
+    let mut i = 0usize;
+    while i < tokens.len() {
+        if tokens[i].newline {
+            lines.push(Vec::new());
+            line_width = 0.0;
+            i += 1;
+            continue;
+        }
+        let first = i;
+        let split_word = tokens[i].whitespace || tokens[i].cjk || tokens[i].ruby.is_some();
+        if split_word {
+            i += 1;
+            while i < tokens.len() && tokens[i].whitespace == tokens[first].whitespace
+                && tokens[i].cjk == tokens[first].cjk && tokens[i].ruby.is_none()
+                && !tokens[i].newline && tokens[i].whitespace
+            { i += 1; }
+        } else {
+            i += 1;
+            while i < tokens.len() && !tokens[i].newline && !tokens[i].whitespace
+                && !tokens[i].cjk && tokens[i].ruby.is_none()
+            { i += 1; }
+        }
+        let group_width = if tokens[first].ruby.is_some() {
+            tokens[first].width
+        } else {
+            // Preserve native shaping/kern advances within each same-font
+            // slice when deciding a Latin word break. Per-scalar widths are
+            // only the fallback used to hard-split an overwide word.
+            let mut width = 0.0f32;
+            let mut from = first;
+            while from < i {
+                let slot = tokens[from].font_slot;
+                let mut to = from + 1;
+                while to < i && tokens[to].font_slot == slot { to += 1; }
+                let text = source_slice(source, tokens[from].start, tokens[to - 1].end);
+                width += advance(fonts, native, text, slot, tracking, line_height).0;
+                from = to;
+            }
+            width
+        };
+        if line_width > 0.0 && !tokens[first].whitespace && line_width + group_width > wrap_width {
+            lines.push(Vec::new());
+            line_width = 0.0;
+        }
+        // Oversized words are split at scalar boundaries, preserving the
+        // pinned Core's documented fallback for words wider than a row.
+        if group_width > wrap_width && i - first > 1 {
+            for token in &tokens[first..i] {
+                if line_width > 0.0 && line_width + token.width > wrap_width {
+                    lines.push(Vec::new());
+                    line_width = 0.0;
+                }
+                line_width += token.width;
+                lines.last_mut().unwrap().push(token.clone());
+            }
+        } else {
+            for token in &tokens[first..i] {
+                line_width += token.width;
+                lines.last_mut().unwrap().push(token.clone());
+            }
+        }
+    }
+
+    let fallback_text = "M";
+    let (_, fallback_height) = advance(fonts, native, fallback_text, base_slot, 0.0, line_height);
+    let default_line_height = fallback_height.max(1.0);
+    let mut fragments = Vec::new();
+    let mut y = 0.0f32;
+    let mut max_line_width = 0.0f32;
+    for line in &lines {
+        // Merge adjacent source scalars with equal paint semantics so native
+        // TextPainter keeps shaping within each styled fragment.
+        let mut groups: Vec<(u32, u32, u8, Option<u32>, u32, Option<crate::tree::InlineRuby>)> = Vec::new();
+        for token in line {
+            if token.ruby.is_none() {
+                if let Some(last) = groups.last_mut() {
+                    if last.1 == token.start && last.2 == token.font_slot && last.3 == token.color
+                        && last.4 == token.link_id && last.5.is_none()
+                    { last.1 = token.end; continue; }
+                }
+            }
+            groups.push((token.start, token.end, token.font_slot, token.color, token.link_id, token.ruby.clone()));
+        }
+        let ruby_lane = line.iter().map(|token| token.ruby_height).fold(0.0f32, f32::max);
+        let mut prepared = Vec::with_capacity(groups.len());
+        let mut line_w = 0.0f32;
+        let mut line_h = default_line_height;
+        for (start, end, slot, color, link_id, ruby) in groups {
+            let text = source_slice(source, start, end);
+            let (base_w, main_h) = advance(fonts, native, text, slot, tracking, line_height);
+            let ruby_info = ruby.map(|ruby| {
+                let ruby_slot = ruby.font_slot.unwrap_or(base_slot);
+                let (ruby_w, ruby_h) = advance(fonts, native, &ruby.text, ruby_slot, 0.0, f32::NAN);
+                InlineRubyFragment { text: ruby.text, x: 0.0, y: 0.0, width: ruby_w,
+                    height: ruby_h, font_slot: ruby_slot, color: ruby.color }
+            });
+            let outer_w = ruby_info.as_ref().map_or(base_w, |ruby| base_w.max(ruby.width));
+            line_h = line_h.max(main_h);
+            line_w += outer_w;
+            prepared.push((start, end, slot, color, link_id, base_w, main_h, outer_w, ruby_info));
+        }
+        max_line_width = max_line_width.max(line_w);
+        let mut x = 0.0f32;
+        for (start, end, slot, color, link_id, base_w, main_h, outer_w, ruby) in prepared {
+            let base_x = x + (outer_w - base_w) * 0.5;
+            let ruby = ruby.map(|mut ruby| {
+                ruby.x = x + (outer_w - ruby.width) * 0.5;
+                ruby.y = y + ((ruby_lane - ruby.height).max(0.0) * 0.5);
+                ruby
+            });
+            fragments.push(InlineFragment {
+                start, end, x: base_x, y: y + ruby_lane, width: base_w, height: main_h.max(default_line_height),
+                font_slot: slot, color, link_id, ruby,
+            });
+            x += outer_w;
+        }
+        y += ruby_lane + line_h;
+    }
+    let width = if max_width.is_finite() && max_width >= 0.0 { max_width } else { max_line_width };
+    InlineTextLayout { width, height: y, line_count: lines.len() as u32, fragments }
+}
+
+/// Append one link's source rectangles to a compact u32 response. Geometry
+/// is leaf-local. Adjacent fragments on the same line are merged.
+pub fn encode_query(layout: &InlineTextLayout, spec: &InlineTextSpec, reveal: u32, node_width: f32, node_height: f32) -> Vec<u32> {
+    let mut links: Vec<(u32, Vec<[f32; 4]>, u32)> = Vec::new();
+    for fragment in &layout.fragments {
+        if fragment.link_id == 0 { continue; }
+        let link_end = spec.runs.iter().filter(|run| run.link_id == fragment.link_id).map(|run| run.end).max().unwrap_or(fragment.end);
+        if link_end > reveal { continue; }
+        let rect = [fragment.x, fragment.y, fragment.width, fragment.height];
+        if let Some((_, rects, _)) = links.iter_mut().find(|(id, _, _)| *id == fragment.link_id) {
+            if let Some(last) = rects.last_mut() {
+                if (last[1] - rect[1]).abs() < 0.01 && (last[0] + last[2] - rect[0]).abs() < 0.75 {
+                    last[2] += rect[2];
+                    continue;
+                }
+            }
+            rects.push(rect);
+        } else {
+            links.push((fragment.link_id, alloc::vec![rect], link_end));
+        }
+    }
+    // Header: width, height, lineCount, linkCount. Then each link id, rect
+    // count and x/y/w/h float bit-tuples.
+    let mut out = alloc::vec![node_width.to_bits(), node_height.to_bits(), layout.line_count, links.len() as u32];
+    for (id, rects, _) in links {
+        out.push(id);
+        out.push(rects.len() as u32);
+        for rect in rects { for value in rect { out.push(value.to_bits()); } }
+    }
+    out
+}

