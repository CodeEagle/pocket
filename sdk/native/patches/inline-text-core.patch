+    assert_eq!(painted_color(&mut ui, "AB"), 0xff12_3456);
+
+    ui.tree.slots[slot as usize].inline_text.as_mut().unwrap().runs[0].ruby.as_mut().unwrap().color = None;
+    ui.mark_layout_style(slot);
+    ui.get_inline_text_layout(text);
+    assert_eq!(painted_color(&mut ui, "ru"), 0xff12_3456);
+}
