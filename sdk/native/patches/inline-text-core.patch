+    feed(&resolved.tracking.to_bits().to_le_bytes());
+    feed(&resolved.line_height.to_bits().to_le_bytes());
+    feed(&[u8::from(native)]);
+    feed(&epoch.to_le_bytes());
+    for run in &spec.runs {
