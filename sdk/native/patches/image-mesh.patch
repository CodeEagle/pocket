diff --git a/engine/core/src/mesh.rs b/engine/core/src/mesh.rs
new file mode 100644
--- /dev/null
+++ b/engine/core/src/mesh.rs
@@ -0,0 +1,164 @@
+//! Bounded retained image meshes and their optional MFX1 paint effects.
+use alloc::vec::Vec;
+use crate::{Ui, spec, tex_resolve};
+
+pub(crate) struct ImageMesh {
+    pub bytes: Vec<u8>,
+    effect: Vec<u8>,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct MeshEffect<'a> {
+    bytes: &'a [u8],
+}
+
+impl MeshEffect<'_> {
+    pub fn blend(&self) -> u32 { word(self.bytes, 4) }
+    pub fn mask_count(&self) -> usize { word(self.bytes, 8) as usize }
+    pub fn inverted(&self) -> bool { word(self.bytes, 12) & 1 != 0 }
+    pub fn repeat_texture(&self) -> bool { word(self.bytes, 12) & 2 != 0 }
+    pub fn needs_layer(&self) -> bool {
+        self.blend() != 0
+            || self.mask_count() != 0
+            || self.multiply_rgb().iter().any(|value| *value != 1.0)
+            || self.screen_rgb().iter().any(|value| *value != 0.0)
+    }
+    pub fn multiply_rgb(&self) -> [f32; 3] {
+        core::array::from_fn(|i| f32::from_bits(word(self.bytes, 16 + i * 4)))
+    }
+    pub fn screen_rgb(&self) -> [f32; 3] {
+        core::array::from_fn(|i| f32::from_bits(word(self.bytes, 28 + i * 4)))
+    }
+    pub fn mask_id(&self, index: usize) -> i32 {
+        word(self.bytes, 40 + index * 4) as i32
+    }
+}
+
+impl ImageMesh {
+    pub fn vertex_count(&self) -> usize { word(&self.bytes, 4) as usize }
+    pub fn index_count(&self) -> usize { word(&self.bytes, 8) as usize }
+    pub fn color(&self) -> u32 { word(&self.bytes, 12) }
+    pub fn vertex(&self, i: usize) -> [f32; 4] {
+        core::array::from_fn(|j| f32::from_bits(word(&self.bytes, 16 + i * 16 + j * 4)))
+    }
+    pub fn index(&self, i: usize) -> usize { word(&self.bytes, 16 + self.vertex_count() * 16 + i * 4) as usize }
+    pub fn effect(&self) -> Option<MeshEffect<'_>> {
+        (!self.effect.is_empty()).then_some(MeshEffect { bytes: &self.effect })
+    }
+    pub fn allocated_bytes(&self) -> usize {
+        self.bytes.capacity() + self.effect.capacity()
+    }
+}
+fn word(bytes: &[u8], i: usize) -> u32 { u32::from_le_bytes(bytes[i..i + 4].try_into().unwrap()) }
+const MAX_VERTICES: usize = 16_384;
+const MAX_INDICES: usize = 98_304;
+const MAX_MASKS: usize = 64;
+const BUDGET: usize = 8 * 1024 * 1024;
+const MESH_EFFECT_MAGIC: u32 = u32::from_le_bytes(*b"MFX1");
+
+impl Ui {
+    /// Native allocation fact for mesh lifetime/budget diagnostics.
+    pub fn mesh_memory_bytes(&self) -> usize { self.mesh_bytes }
+
+    /// PMS1: magic, vertex count, index count, ABGR; [x,y,u,v] f32 rows,
+    /// then u32 triangle indices. Invalid input is atomic: old mesh survives.
+    /// Empty bytes clear the mesh and image. Normal blending, 2D only.
+    pub fn set_mesh(&mut self, id: i32, texture: i32, bytes: &[u8]) -> bool {
+        let Some(slot) = self.tree.resolve(id) else { return false; };
+        let node = &self.tree.slots[slot as usize];
+        if node.node_type != spec::NodeType::Image as u8 { return false; }
+        if bytes.is_empty() { self.set_image(id, -1); return true; }
+        if tex_resolve(&self.textures, texture).is_none() || bytes.len() < 16 { return false; }
+        let n = word(bytes, 4) as usize;
+        let m = word(bytes, 8) as usize;
+        if word(bytes, 0) != 0x31534d50 || n == 0 || n > MAX_VERTICES || m == 0 || m > MAX_INDICES || m % 3 != 0 || bytes.len() != 16 + n * 16 + m * 4 { return false; }
+        for i in 0..n {
+            for j in 0..4 {
+                let v = f32::from_bits(word(bytes, 16 + i * 16 + j * 4));
+                if !v.is_finite() || v.abs() > 1_000_000.0 { return false; }
+            }
+        }
+        for i in 0..m { if word(bytes, 16 + n * 16 + i * 4) as usize >= n { return false; } }
+        let old = node.mesh.as_ref().map_or(0, ImageMesh::allocated_bytes);
+        let old_geometry = node.mesh.as_ref().map_or(0, |mesh| mesh.bytes.capacity());
+        let effect_capacity = node.mesh.as_ref().map_or(0, |mesh| mesh.effect.capacity());
+        let reuse = old_geometry >= bytes.len() && old_geometry <= bytes.len() * 2;
+        let needed = (if reuse { old_geometry } else { bytes.len() }) + effect_capacity;
+        if self.mesh_bytes - old + needed > BUDGET { return false; }
+        let node = &mut self.tree.slots[slot as usize];
+        let mut mesh = node.mesh.take().unwrap_or(ImageMesh { bytes: Vec::new(), effect: Vec::new() });
+        if !reuse { mesh.bytes = bytes.to_vec(); }
+        else { mesh.bytes.clear(); mesh.bytes.extend_from_slice(bytes); }
+        self.mesh_bytes = self.mesh_bytes - old + mesh.allocated_bytes();
+        node.mesh = Some(mesh);
+        node.tex = texture;
+        node.sprite_frames = 0;
+        true
+    }
+
+    /// MFX1: magic, normalized blend (normal/add/multiply/screen), mask count,
+    /// flags (bit 0 inverted, bit 1 repeat texture), multiply RGB, screen RGB,
+    /// then generation-tagged node ids.
+    /// Empty bytes clear the effect. All masks must already have retained meshes.
+    pub fn set_mesh_effect(&mut self, id: i32, bytes: &[u8]) -> bool {
+        let Some(slot) = self.tree.resolve(id) else { return false; };
+        let node = &self.tree.slots[slot as usize];
+        if node.node_type != spec::NodeType::Image as u8 || node.mesh.is_none() {
+            return false;
+        }
+        if !bytes.is_empty() {
+            if bytes.len() < 40 || word(bytes, 0) != MESH_EFFECT_MAGIC {
+                return false;
+            }
+            let blend = word(bytes, 4);
+            let mask_count = word(bytes, 8) as usize;
+            let flags = word(bytes, 12);
+            if blend > 3
+                || mask_count > MAX_MASKS
+                || flags & !3 != 0
+                || (mask_count == 0 && flags & 1 != 0)
+                || bytes.len() != 40 + mask_count * 4
+            {
+                return false;
+            }
+            for index in 4..10 {
+                let value = f32::from_bits(word(bytes, index * 4));
+                if !value.is_finite() || !(0.0..=1.0).contains(&value) {
+                    return false;
+                }
+            }
+            for index in 0..mask_count {
+                let mask_id = word(bytes, 40 + index * 4) as i32;
+                if mask_id <= 0 || mask_id == id {
+                    return false;
+                }
+                for previous in 0..index {
+                    if word(bytes, 40 + previous * 4) as i32 == mask_id {
+                        return false;
+                    }
+                }
+                let Some(mask_slot) = self.tree.resolve(mask_id) else { return false; };
+                let mask = &self.tree.slots[mask_slot as usize];
+                if mask.node_type != spec::NodeType::Image as u8
+                    || mask.mesh.is_none()
+                    || mask.parent != node.parent
+                {
+                    return false;
+                }
+            }
+        }
+        if node.mesh.as_ref().unwrap().effect.as_slice() == bytes {
+            return true;
+        }
+        let old = node.mesh.as_ref().map_or(0, |mesh| mesh.effect.capacity());
+        let needed = if bytes.is_empty() { 0 } else { bytes.len() };
+        if self.mesh_bytes - old + needed > BUDGET {
+            return false;
+        }
+        let node = &mut self.tree.slots[slot as usize];
+        let mesh = node.mesh.as_mut().unwrap();
+        mesh.effect = if bytes.is_empty() { Vec::new() } else { bytes.to_vec() };
+        self.mesh_bytes = self.mesh_bytes - old + mesh.effect.capacity();
+        true
+    }
+}
