+    fn mesh_world_bounds(&self, mesh: &crate::mesh::ImageMesh, world: &Affine, clip: &Clip) -> Option<Clip> {
+        let mut bounds = None::<Clip>;
+        for index in 0..mesh.vertex_count() {
+            let vertex = mesh.vertex(index);
+            let (x, y) = world.apply(vertex[0], vertex[1]);
+            if !x.is_finite() || !y.is_finite() {
+                return None;
+            }
+            bounds = Some(match bounds {
+                Some(mut current) => {
+                    current.x0 = current.x0.min(x);
+                    current.y0 = current.y0.min(y);
+                    current.x1 = current.x1.max(x);
+                    current.y1 = current.y1.max(y);
+                    current
+                }
+                None => Clip { x0: x, y0: y, x1: x, y1: y },
+            });
+        }
+        let mut bounds = bounds?.intersect(clip).intersect(&Clip::viewport(self.screen));
+        if bounds.is_empty() {
+            return None;
+        }
+        bounds.x0 = floorf(bounds.x0);
+        bounds.y0 = floorf(bounds.y0);
+        bounds.x1 = ceilf(bounds.x1);
+        bounds.y1 = ceilf(bounds.y1);
+        Some(bounds)
+    }
