+    /// Rebuild the mask's world transform from retained tree/style facts.
+    /// Mask nodes are required to be target siblings, so the target clip also
+    /// covers their shared ancestors.
+    fn world_for_slot(&self, slot: u32) -> Option<Affine> {
+        let mut path = [0u32; spec::MAX_TREE_DEPTH as usize + 1];
+        let mut len = 0usize;
+        let mut current = slot;
+        loop {
+            if len == path.len() {
+                return None;
+            }
+            let node = self.tree.slots.get(current as usize)?;
+            path[len] = current;
+            len += 1;
+            if node.parent == 0 {
+                break;
+            }
+            current = self.tree.resolve(node.parent)?;
+        }
+        let mut world = Affine::IDENTITY;
+        while len > 0 {
+            len -= 1;
+            let node = &self.tree.slots[path[len] as usize];
+            let resolved = style::resolve(node, self.styles, true);
+            world = world.then(&local_affine(&node.layout, &resolved));
+        }
+        Some(world)
+    }
+
