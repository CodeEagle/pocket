+#[test]
+fn mesh_effect_groups_are_balanced_and_validate_mode_and_target() {
+    let group = [
+        MESH_LAYER_BEGIN,
+        xy(0, 0),
+        wh(20, 20),
+        3,
+        1.0f32.to_bits(),
+        1.0f32.to_bits(),
+        1.0f32.to_bits(),
+        0.0f32.to_bits(),
+        0.0f32.to_bits(),
+        0.0f32.to_bits(),
+        TEX_TRI,
+        1,
+        xy(0, 0),
+        0,
+        0,
+        xy(20, 0),
+        0,
+        0,
+        xy(0, 20),
+        0,
+        0,
+        0xffff_ffff,
+        MESH_MASK_BEGIN,
+        1,
+        xy(0, 0),
+        wh(20, 20),
+        TEX_TRI,
+        2,
+        xy(0, 0),
+        0,
+        0,
+        xy(20, 0),
+        0,
+        0,
+        xy(0, 20),
+        0,
+        0,
+        0xffff_ffff,
+        MESH_LAYER_RESTORE,
+    ];
+    validate(&group, SCREEN).unwrap();
+
+    let mut repeat_target = group;
+    repeat_target[10] = TEX_TRI_REPEAT;
+    validate(&repeat_target, SCREEN).unwrap();
+    let mut repeat_mask = group;
+    repeat_mask[26] = TEX_TRI_REPEAT;
+    validate(&repeat_mask, SCREEN).unwrap();
+
+    assert_eq!(
+        validate(&[MESH_LAYER_RESTORE], SCREEN),
+        Err(DecodeError::MeshLayerRestoreWithoutLayer)
+    );
+    let mut no_target = group[..10].to_vec();
+    no_target.extend_from_slice(&[MESH_MASK_BEGIN, 0, xy(0, 0), wh(20, 20)]);
+    assert_eq!(
+        validate(&no_target, SCREEN),
+        Err(DecodeError::MeshLayerWithoutTarget)
+    );
+    assert_eq!(
+        validate(&group[..group.len() - 1], SCREEN),
+        Err(DecodeError::UnbalancedMeshLayer)
+    );
+    let mut unsupported_blend = group[..10].to_vec();
+    unsupported_blend[3] = 4;
+    assert_eq!(
+        validate(&unsupported_blend, SCREEN),
+        Err(DecodeError::InvalidMeshBlend)
+    );
+}
