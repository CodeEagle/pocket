+//! Bounded decoder for filtered, zlib-wrapped RGBA8888 tile streams.
+//!
+//! The compiler writes one PNG-style filter byte plus residual bytes per row,
+//! then wraps the complete stream in zlib DEFLATE.  This is deliberately not
+//! a PNG parser: the core only needs a bounded tile decoder and should remain
+//! `no_std + alloc` on wasm32 and embedded/mobile targets.
+
+use alloc::vec::Vec;
+use core::fmt;
+
+use miniz_oxide::{
+    inflate::stream::{inflate, InflateState},
+    DataFormat, MZFlush, MZStatus,
+};
+
+/// TILESET dimensions are bounded by the core texture limit.  Keeping the
+/// guard here also prevents malformed metadata from requesting an unbounded
+/// allocation before the zlib output limit is applied.
+pub const MAX_TILE_DIM: u32 = 512;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DecodeError {
+    EmptyInput,
+    InvalidDimensions,
+    LengthOverflow,
+    Inflate,
+    OutputLength { expected: usize, actual: usize },
+    TrailingInput { consumed: usize, total: usize },
+    BadFilter(u8),
+}
+
+impl fmt::Display for DecodeError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::EmptyInput => f.write_str("empty zlib tile stream"),
+            Self::InvalidDimensions => f.write_str("tile dimensions are outside 1..=512"),
+            Self::LengthOverflow => f.write_str("tile byte length overflow"),
+            Self::Inflate => f.write_str("invalid or truncated zlib stream"),
+            Self::OutputLength { expected, actual } => {
+                write!(f, "zlib output length {actual}, want {expected}")
+            }
+            Self::TrailingInput { consumed, total } => {
+                write!(f, "zlib consumed {consumed} of {total} bytes")
+            }
+            Self::BadFilter(filter) => write!(f, "invalid row filter {filter}"),
+        }
+    }
+}
+
+/// Decode one filtered RGBA8888 tile.
+///
+/// The output is exactly `width * height * 4` bytes in row-major RGBA order.
+/// Inflation is performed with an output slice sized to the exact filtered
+/// stream length, so a compressed bomb cannot grow the result beyond the
+/// declared tile dimensions.  Input must contain exactly one zlib stream;
+/// trailing bytes are rejected rather than silently accepted as padding.
+pub fn decode(input: &[u8], width: u32, height: u32) -> Result<Vec<u8>, DecodeError> {
+    if input.is_empty() {
+        return Err(DecodeError::EmptyInput);
+    }
+    if width == 0 || height == 0 || width > MAX_TILE_DIM || height > MAX_TILE_DIM {
+        return Err(DecodeError::InvalidDimensions);
+    }
+
+    let width = usize::try_from(width).map_err(|_| DecodeError::LengthOverflow)?;
+    let height = usize::try_from(height).map_err(|_| DecodeError::LengthOverflow)?;
+    let row_bytes = width
+        .checked_mul(4)
+        .ok_or(DecodeError::LengthOverflow)?;
+    let rgba_len = row_bytes
+        .checked_mul(height)
+        .ok_or(DecodeError::LengthOverflow)?;
+    let filtered_len = row_bytes
+        .checked_add(1)
+        .and_then(|n| n.checked_mul(height))
+        .ok_or(DecodeError::LengthOverflow)?;
+
+    // `new_boxed` keeps miniz's 32 KiB dictionary off the mobile/wasm stack.
+    let mut state = InflateState::new_boxed(DataFormat::Zlib);
+    let mut filtered = Vec::new();
+    filtered.try_reserve_exact(filtered_len).map_err(|_| DecodeError::LengthOverflow)?;
+    filtered.resize(filtered_len, 0);
+
+    let result = inflate(&mut state, input, &mut filtered, MZFlush::Finish);
+    if result.status != Ok(MZStatus::StreamEnd) {
+        return Err(DecodeError::Inflate);
+    }
+    if result.bytes_written != filtered_len {
+        return Err(DecodeError::OutputLength {
+            expected: filtered_len,
+            actual: result.bytes_written,
+        });
+    }
+    if result.bytes_consumed != input.len() {
+        return Err(DecodeError::TrailingInput {
+            consumed: result.bytes_consumed,
+            total: input.len(),
+        });
+    }
+
+    // Compact/unfilter in place.  For row y, the destination begins y bytes
+    // before its source; iterating x from left to right means each write only
+    // overwrites source bytes that were already consumed.
+    for y in 0..height {
+        let source = y * (row_bytes + 1);
+        let output = y * row_bytes;
+        let filter = filtered[source];
+        if filter > 4 {
+            return Err(DecodeError::BadFilter(filter));
+        }
+        for x in 0..row_bytes {
+            let value = filtered[source + 1 + x];
+            let left = if x >= 4 { filtered[output + x - 4] } else { 0 };
+            let up = if y > 0 {
+                filtered[output - row_bytes + x]
+            } else {
+                0
+            };
+            let up_left = if y > 0 && x >= 4 {
+                filtered[output - row_bytes + x - 4]
+            } else {
+                0
+            };
+            let predictor = match filter {
+                0 => 0,
+                1 => left,
+                2 => up,
+                3 => ((left as u16 + up as u16) >> 1) as u8,
+                4 => paeth(left, up, up_left),
+                _ => unreachable!(),
+            };
+            filtered[output + x] = value.wrapping_add(predictor);
+        }
+    }
+    filtered.truncate(rgba_len);
+    Ok(filtered)
+}
+
+fn paeth(left: u8, up: u8, up_left: u8) -> u8 {
+    let p = left as i32 + up as i32 - up_left as i32;
+    let pa = (p - left as i32).abs();
+    let pb = (p - up as i32).abs();
+    let pc = (p - up_left as i32).abs();
+    if pa <= pb && pa <= pc {
+        left
+    } else if pb <= pc {
+        up
+    } else {
+        up_left
+    }
+}
