+#[path = "../src/tile_rgba_deflate.rs"]
+mod tile_rgba_deflate;
+
+extern crate alloc;
+
+use miniz_oxide::deflate::compress_to_vec_zlib;
+use tile_rgba_deflate::{decode, DecodeError};
+
+fn filter_rows(rgba: &[u8], width: usize, height: usize) -> Vec<u8> {
+    let row_bytes = width * 4;
+    let mut filtered = Vec::with_capacity((row_bytes + 1) * height);
+    for y in 0..height {
+        let filter = (y % 5) as u8;
+        filtered.push(filter);
+        for x in 0..row_bytes {
+            let value = rgba[y * row_bytes + x];
+            let left = if x >= 4 { rgba[y * row_bytes + x - 4] } else { 0 };
+            let up = if y > 0 { rgba[(y - 1) * row_bytes + x] } else { 0 };
+            let up_left = if y > 0 && x >= 4 {
+                rgba[(y - 1) * row_bytes + x - 4]
+            } else {
+                0
+            };
+            let predictor = match filter {
+                0 => 0,
+                1 => left,
+                2 => up,
+                3 => ((left as u16 + up as u16) >> 1) as u8,
+                4 => paeth(left, up, up_left),
+                _ => unreachable!(),
+            };
+            filtered.push(value.wrapping_sub(predictor));
+        }
+    }
+    filtered
+}
+
+fn paeth(left: u8, up: u8, up_left: u8) -> u8 {
+    let p = left as i32 + up as i32 - up_left as i32;
+    let pa = (p - left as i32).abs();
+    let pb = (p - up as i32).abs();
+    let pc = (p - up_left as i32).abs();
+    if pa <= pb && pa <= pc {
+        left
+    } else if pb <= pc {
+        up
+    } else {
+        up_left
+    }
+}
+
+#[test]
+fn round_trips_all_row_filters_and_alpha() {
+    let width = 23;
+    let height = 13;
+    let mut rgba = vec![0u8; width * height * 4];
+    for y in 0..height {
+        for x in 0..width {
+            let i = (y * width + x) * 4;
+            rgba[i] = (x * 37 + y * 11) as u8;
+            rgba[i + 1] = (x * 13 + y * 53 + 7) as u8;
+            rgba[i + 2] = (x * 71 + y * 19 + 29) as u8;
+            rgba[i + 3] = (x * 17 + y * 31 + 3) as u8;
+        }
+    }
+    let filtered = filter_rows(&rgba, width, height);
+    let compressed = compress_to_vec_zlib(&filtered, 9);
+    assert_eq!(decode(&compressed, width as u32, height as u32).unwrap(), rgba);
+}
+
+#[test]
+fn rejects_trailing_bytes_and_bad_filters() {
+    let rgba = [0x10, 0x20, 0x30, 0x40];
+    let filtered = filter_rows(&rgba, 1, 1);
+    let compressed = compress_to_vec_zlib(&filtered, 9);
+
+    let mut trailing = compressed.clone();
+    trailing.push(0);
+    assert!(matches!(
+        decode(&trailing, 1, 1),
+        Err(DecodeError::TrailingInput { .. })
+    ));
+
+    let mut bad_filter = filter_rows(&rgba, 1, 1);
+    bad_filter[0] = 5;
+    let bad_compressed = compress_to_vec_zlib(&bad_filter, 9);
+    assert_eq!(decode(&bad_compressed, 1, 1), Err(DecodeError::BadFilter(5)));
+}
