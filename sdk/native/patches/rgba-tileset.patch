+/// Build one v2 RGBA8888 tile. It deliberately uses RLE over the full
+/// four-byte stream so the native path proves that bytes-per-pixel follows
+/// the version/format, not the legacy CLUT8 palette convention.
+fn tiny_rgba_tileset() -> Vec<u8> {
+    use spec::tileset as ts;
+    let mut blob = Vec::new();
+    blob.extend_from_slice(&ts::MAGIC.to_le_bytes());
+    blob.extend_from_slice(&ts::RGBA_VERSION.to_le_bytes());
+    blob.extend_from_slice(&(ts::FLAG_RLE | ts::FLAG_LINEAR | ts::FLAG_RGBA8888).to_le_bytes());
+    blob.extend_from_slice(&4u16.to_le_bytes()); // tileW
+    blob.extend_from_slice(&4u16.to_le_bytes()); // tileH
+    blob.extend_from_slice(&1u16.to_le_bytes()); // cols
+    blob.extend_from_slice(&1u16.to_le_bytes()); // rows
+    blob.extend_from_slice(&0u32.to_le_bytes()); // no palette in v2
+    let dir_off = ts::HEADER_SIZE as u32;
+    let data_off = dir_off + ts::DIR_ENTRY_SIZE as u32;
+    blob.extend_from_slice(&dir_off.to_le_bytes());
+    blob.extend_from_slice(&data_off.to_le_bytes());
+    blob.extend_from_slice(&0u32.to_le_bytes()); // reserved
+    let pixels = [0x12u8, 0x34, 0x56, 0x78].repeat(16);
+    let stream = packbits_encode(&pixels);
+    blob.extend_from_slice(&0u32.to_le_bytes());
+    blob.extend_from_slice(&(stream.len() as u32).to_le_bytes());
+    blob.extend_from_slice(&stream);
+    blob
+}
