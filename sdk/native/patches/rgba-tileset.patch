+/// Build one v2 filtered RGBA tile using filter 0 for every row. The actual
+/// cooker chooses the best PNG row filter; this vector isolates the native
+/// zlib/unfilter path without depending on the TypeScript toolchain.
+fn tiny_rgba_deflate_tileset() -> Vec<u8> {
+    use miniz_oxide::deflate::compress_to_vec_zlib;
+    use spec::tileset as ts;
+    let mut blob = Vec::new();
+    blob.extend_from_slice(&ts::MAGIC.to_le_bytes());
+    blob.extend_from_slice(&ts::RGBA_VERSION.to_le_bytes());
+    blob.extend_from_slice(
+        &(ts::FLAG_LINEAR | ts::FLAG_RGBA8888 | ts::FLAG_RGBA_DEFLATE).to_le_bytes(),
+    );
+    blob.extend_from_slice(&4u16.to_le_bytes());
+    blob.extend_from_slice(&4u16.to_le_bytes());
+    blob.extend_from_slice(&1u16.to_le_bytes());
+    blob.extend_from_slice(&1u16.to_le_bytes());
+    blob.extend_from_slice(&0u32.to_le_bytes());
+    let dir_off = ts::HEADER_SIZE as u32;
+    let data_off = dir_off + ts::DIR_ENTRY_SIZE as u32;
+    blob.extend_from_slice(&dir_off.to_le_bytes());
+    blob.extend_from_slice(&data_off.to_le_bytes());
+    blob.extend_from_slice(&0u32.to_le_bytes());
+    let mut filtered = Vec::with_capacity((4 * 4 + 1) * 4);
+    for _ in 0..4 {
+        filtered.push(0);
+        for _ in 0..4 {
+            filtered.extend_from_slice(&[0x12, 0x34, 0x56, 0xff]);
+        }
+    }
+    let stream = compress_to_vec_zlib(&filtered, 9);
+    blob.extend_from_slice(&0u32.to_le_bytes());
+    blob.extend_from_slice(&(stream.len() as u32).to_le_bytes());
+    blob.extend_from_slice(&stream);
+    blob
