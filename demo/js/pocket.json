{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.tryjoy.pocket-host.showcase",
  "name": "pocket-host-showcase",
  "title": "PocketJS Flutter host showcase",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked"],
      "enhances": []
    }
  },
  "app": {
    "entry": "app.tsx",
    "output": "app",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [360, 640],
        "presentation": "native"
      }
    }
  }
}
