{
  "$schema": "https://pocketjs.dev/schema/pocket-guest-manifest.json",
  "protocolVersion": 1,
  "capabilities": {
    "requires": [
      "text.glyphs.baked",
      "ui.compositor-surfaces"
    ],
    "optional": [
      "runtime.info",
      "runtime.performance",
      "diagnostics.recording.start",
      "diagnostics.recording.status",
      "diagnostics.recording.stop",
      "diagnostics.recording.export",
      "diagnostics.recording.replay",
      "plugins.list",
      "plugins.packageInfo",
      "updates.status",
      "updates.check",
      "updates.apply",
      "updates.rollback",
      "platform.apps.list",
      "platform.apps.open",
      "platform.apps.return",
      "platform.apps.cancel",
      "platform.apps.prewarm",
      "platform.storage.get",
      "platform.storage.set",
      "platform.storage.remove",
      "platform.storage.keys",
      "platform.messages.send",
      "platform.messages.receive",
      "hardware.permissions",
      "hardware.permissions.request",
      "hardware.camera.preview.start",
      "hardware.camera.preview.stop",
      "hardware.camera.lens.switch",
      "hardware.camera.flash.toggle",
      "hardware.camera.capture",
      "hardware.photos.list",
      "hardware.photos.delete",
      "hardware.bluetooth.scan",
      "hardware.bluetooth.connect",
      "hardware.sensors.read",
      "hardware.sensors.watch",
      "hardware.bluetooth.read",
      "hardware.bluetooth.write",
      "hardware.bluetooth.notifications",
      "hardware.biometrics.authenticate",
      "hardware.location.current",
      "hardware.weather.current",
      "platform.systemUi.set",
      "platform.haptics.perform",
      "system.runtime.configure",
      "system.runtime.create",
      "system.runtime.awaitFirstFrame",
      "system.runtime.destroy",
      "system.runtime.post",
      "system.runtime.respond",
      "system.storage.get",
      "system.storage.set",
      "system.storage.remove",
      "system.storage.keys"
    ]
  },
  "permissions": {
    "optional": [
      "hardware.camera",
      "hardware.photos",
      "hardware.bluetooth",
      "hardware.sensors",
      "hardware.biometrics",
      "hardware.location",
      "hardware.microphone",
      "hardware.network"
    ]
  }
}
