platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # POCKET_STATIC_XCFRAMEWORK_OUTPUTS_BEGIN
  pocket_static_xcframework_output_path = File.join(__dir__, "Pods", "Target Support Files", "pocket_flutter", "pocket_flutter-xcframeworks-output-files.xcfilelist")
  if File.file?(pocket_static_xcframework_output_path)
    pocket_static_xcframework_output_old = "${PODS_XCFRAMEWORKS_BUILD_DIR}/pocket_flutter/PocketFlutter.framework"
    pocket_static_xcframework_output_new = "${PODS_XCFRAMEWORKS_BUILD_DIR}/pocket_flutter/libpocket_flutter.a"
    pocket_static_xcframework_output_lines = File.read(pocket_static_xcframework_output_path).lines
    pocket_static_xcframework_output_changed = false
    pocket_static_xcframework_output_lines.map! do |line|
      if line.chomp == pocket_static_xcframework_output_old
        pocket_static_xcframework_output_changed = true
        if line.end_with?("\r\n")
          "#{pocket_static_xcframework_output_new}\r\n"
        elsif line.end_with?("\n")
          "#{pocket_static_xcframework_output_new}\n"
        else
          pocket_static_xcframework_output_new
        end
      else
        line
      end
    end
    if pocket_static_xcframework_output_changed
      File.write(pocket_static_xcframework_output_path, pocket_static_xcframework_output_lines.join)
    end
  end
  # POCKET_STATIC_XCFRAMEWORK_OUTPUTS_END
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # The compatibility hardware provider delegates OS permissions to permission_handler.
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        'PERMISSION_CAMERA=1', 'PERMISSION_PHOTOS_ADD_ONLY=1',
        'PERMISSION_BLUETOOTH=1', 'PERMISSION_LOCATION=1',
        'PERMISSION_MICROPHONE=1', 'PERMISSION_SENSORS=1',
      ]
    end
      target.build_configurations.each { |config| config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'; config.build_settings['ARCHS'] = 'arm64' }
    # Xcode 27's simulator SDK rejects older Pod deployment targets as well.
    target.build_configurations.each do |config|
      minimum = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if minimum.nil? || minimum.to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
